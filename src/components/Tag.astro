---
import IconHash from "@/assets/icons/IconHash.svg";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;
---

<li class="list-none">
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={[
      "blog-tag no-underline inline-flex items-center gap-0.5",
      { "text-xs px-2 py-0.5": size === "sm" },
      { "text-sm px-3 py-1": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-4": size === "lg" },
        { "size-3": size === "sm" },
      ]}
    />
    {tagName}
  </a>
</li>
