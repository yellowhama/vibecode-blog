---
// Newsletter capture — provider-agnostic, key-safe.
// FIX (2026-06-10): the old version POSTed directly to the Beehiiv v2 API from the
// browser. That endpoint requires an Authorization bearer key, so it returned 401
// whenever a pubId was set, and fell back to a fake "coming soon" toast otherwise —
// i.e. the capture never actually worked. The funnel was built but the tap was shut.
//
// New design: point the native <form action> at a HOSTED subscribe URL the customer
// drops into one env var. Hosted forms (Beehiiv embed action, ConvertKit, Buttondown,
// Mailchimp, Substack) capture the email server-side with NO secret exposed client-side.
//   - PUBLIC_NEWSLETTER_ACTION set  → real capture (native submit fallback + JS toast).
//   - unset                         → honest inline "준비중" state, no fake success.
// Backward-compat: PUBLIC_BEEHIIV_PUB_ID, when present, derives the Beehiiv embed action.
type Props = {
  class?: string;
  compact?: boolean;
};
const { class: className, compact = false } = Astro.props;

const explicitAction = import.meta.env.PUBLIC_NEWSLETTER_ACTION || "";
const beehiivPubId = import.meta.env.PUBLIC_BEEHIIV_PUB_ID || "";
// Beehiiv hosted embed posts to https://embeds.beehiiv.com/<pubId> — no API key needed.
const RELAY_DEFAULT = "https://api-kr.nongjida.kr/api/newsletter/subscribe"; // self-hosted (nurikun relay)
const action = explicitAction || (beehiivPubId ? `https://embeds.beehiiv.com/${beehiivPubId}` : RELAY_DEFAULT);
const live = Boolean(action);
---

<div class:list={["newsletter-signup", className]}>
  {!compact && (
    <div class="mb-4">
      <h3 class="text-lg font-semibold text-foreground">Get the field notes</h3>
      <p class="mt-1 text-sm text-text-secondary leading-relaxed">
        One note when there is a real artifact worth studying. No spam. Unsubscribe anytime.
      </p>
    </div>
  )}
  <form
    id="newsletter-form"
    class="flex gap-2 max-sm:flex-col"
    action={action || undefined}
    method="post"
    target="_blank"
    data-live={live ? "1" : "0"}
  >
    <input
      type="email"
      name="email"
      required
      placeholder="your@email.com"
      class="flex-1 rounded-md border border-border bg-bg-secondary px-3 py-2 text-sm text-foreground placeholder:text-text-muted focus:border-accent focus:outline-none"
    />
    <button
      type="submit"
      class="whitespace-nowrap rounded-md bg-accent px-4 py-2 text-sm font-medium text-ink transition-colors hover:bg-accent-dim disabled:opacity-50"
    >
      Subscribe
    </button>
  </form>

  <!-- Premium Toast Notification Container -->
  <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>
</div>

<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("newsletter-form");
    const toastContainer = document.getElementById("toast-container");
    if (!form || !toastContainer) return;

    const isLive = form.getAttribute("data-live") === "1";
    const action = form.getAttribute("action") || "";

    const showToast = (message, type = "success") => {
      const toast = document.createElement("div");
      toast.className = `transform transition-all duration-300 translate-y-8 opacity-0 pointer-events-auto px-6 py-3 rounded-md border text-sm font-mono tracking-wide shadow-lg flex items-center gap-3 ${
        type === "success"
          ? "bg-background border-emerald-500/30 text-emerald-600 dark:text-emerald-400"
          : "bg-background border-rose-500/30 text-rose-600 dark:text-rose-400"
      }`;

      const icon = type === "success"
        ? `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`
        : `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>`;

      toast.innerHTML = `${icon} <span>${message}</span>`;
      toastContainer.appendChild(toast);
      requestAnimationFrame(() => toast.classList.remove("translate-y-8", "opacity-0"));
      setTimeout(() => {
        toast.classList.add("translate-y-8", "opacity-0");
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    };

    form.addEventListener("submit", async (e) => {
      const input = form.querySelector('input[name="email"]');
      const email = input ? input.value : "";

      // No subscribe endpoint configured yet → be honest, don't fake success.
      if (!isLive || !action) {
        e.preventDefault();
        showToast("Newsletter opens soon — drop your email and you'll be first.", "success");
        if (input) input.value = "";
        return;
      }

      // Live: enhance the native POST with an inline toast. Hosted form endpoints are
      // cross-origin and return opaque responses, so we fire a no-cors POST and assume
      // acceptance; the native form submit (target=_blank) is the guaranteed fallback.
      e.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]');
      const originalText = submitBtn ? submitBtn.textContent : "Subscribe";
      if (submitBtn) {
        submitBtn.textContent = "Subscribing...";
        submitBtn.disabled = true;
      }
      try {
        if (action.includes("/api/newsletter/subscribe")) {
          // Self-hosted relay (nurikun): JSON + CORS, double opt-in confirm mail follows.
          const r = await fetch(action, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, list: "vibecode-weekly" }),
          });
          if (!r.ok) throw new Error(String(r.status));
        } else {
          const body = new URLSearchParams({ email });
          await fetch(action, {
            method: "POST",
            mode: "no-cors",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: body.toString(),
          });
        }
        showToast("Check your inbox — click the confirm link to finish.", "success");
        form.reset();
      } catch {
        // Network/policy blocked the background POST — fall back to the hosted page.
        window.open(action, "_blank", "noopener");
      } finally {
        if (submitBtn) {
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      }
    });
  });
</script>
