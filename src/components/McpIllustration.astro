---
---
<div class="mcp-illustration-wrap my-12 p-8 bg-ink rounded-3xl border-2 border-accent/20 relative overflow-hidden group">
  <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(var(--color-accent) 1px, transparent 1px); background-size: 20px 24px;"></div>
  
  <svg viewBox="0 0 600 300" class="relative z-10 w-full h-auto drop-shadow-[0_0_15px_rgba(255,241,51,0.2)]">
    <rect x="250" y="110" width="100" height="80" rx="12" fill="var(--color-accent)" class="animate-pulse" />
    <text x="300" y="155" font-family="monospace" font-size="12" font-weight="900" text-anchor="middle" fill="#2D1D19">AI HOST</text>
    
    <g stroke="var(--color-accent)" stroke-width="1.5" stroke-dasharray="4 4" opacity="0.6">
      <path d="M250,150 L100,50" class="line-anim-1" />
      <path d="M250,150 L100,250" class="line-anim-2" />
      <path d="M350,150 L500,50" class="line-anim-3" />
      <path d="M350,150 L500,250" class="line-anim-4" />
    </g>
    
    <circle cx="100" cy="50" r="20" fill="none" stroke="var(--color-accent)" stroke-width="2" />
    <text x="100" y="90" font-family="monospace" font-size="10" text-anchor="middle" fill="var(--color-accent)" opacity="0.8">GITHUB_MCP</text>
    
    <circle cx="100" cy="250" r="20" fill="none" stroke="var(--color-accent)" stroke-width="2" />
    <text x="100" y="290" font-family="monospace" font-size="10" text-anchor="middle" fill="var(--color-accent)" opacity="0.8">SQL_SERVER</text>
    
    <circle cx="500" cy="50" r="20" fill="none" stroke="var(--color-accent)" stroke-width="2" />
    <text x="500" y="90" font-family="monospace" font-size="10" text-anchor="middle" fill="var(--color-accent)" opacity="0.8">DOCS_API</text>
    
    <circle cx="500" cy="250" r="20" fill="none" stroke="var(--color-accent)" stroke-width="2" />
    <text x="500" y="290" font-family="monospace" font-size="10" text-anchor="middle" fill="var(--color-accent)" opacity="0.8">BROWSER_CLI</text>
  </svg>
</div>

<style>
  .line-anim-1 { animation: dash 2s linear infinite; }
  .line-anim-2 { animation: dash 2.5s linear infinite; }
  .line-anim-3 { animation: dash 3s linear infinite; }
  .line-anim-4 { animation: dash 1.5s linear infinite; }
  @keyframes dash { to { stroke-dashoffset: -20; } }
</style>
