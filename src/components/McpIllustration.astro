---
---
<div class="mcp-diagram my-16 p-8 bg-[#1A1210] rounded-3xl border-[3px] border-border/50 relative overflow-hidden group">
  <div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: url('https://www.transparenttextures.com/patterns/carbon-fibre.png');"></div>

  <!-- Header -->
  <div class="flex justify-between items-center mb-12 relative z-10 border-b border-white/5 pb-6">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-accent flex items-center justify-center shadow-[0_0_15px_rgba(255,241,51,0.4)]">
         <span class="font-mono text-ink font-black text-xs">USB</span>
      </div>
      <h4 class="text-xl font-serif italic text-text-primary uppercase tracking-tighter">Fig 1.1: The MCP Transport Pipeline</h4>
    </div>
    <div class="flex items-center gap-2">
       <span class="px-2 py-0.5 rounded-full bg-accent/10 text-accent text-[8px] font-mono tracking-widest font-black uppercase">Standardized</span>
    </div>
  </div>

  <!-- Diagram SVG -->
  <svg viewBox="0 0 800 400" class="relative z-10 w-full h-auto drop-shadow-2xl">
    <defs>
      <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="0" refY="3.5" orient="auto">
        <polygon points="0 0, 10 3.5, 0 7" fill="var(--color-accent)" />
      </marker>
      <filter id="glow">
        <feGaussianBlur stdDeviation="2.5" result="coloredBlur"/>
        <feMerge>
          <feMergeNode in="coloredBlur"/><feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>

    <!-- STEP 1: HOST -->
    <g class="step-1">
      <rect x="20" y="150" width="160" height="100" rx="16" fill="#2D1D19" stroke="var(--color-accent)" stroke-width="2" filter="url(#glow)" />
      <text x="100" y="195" font-family="monospace" font-size="14" font-weight="900" text-anchor="middle" fill="var(--color-accent)">MCP HOST</text>
      <text x="100" y="220" font-family="serif" font-size="10" font-style="italic" text-anchor="middle" fill="var(--color-accent)" opacity="0.6">(Cursor / Claude)</text>
      <circle cx="35" cy="165" r="8" fill="var(--color-accent)" />
      <text x="35" y="168" font-family="monospace" font-size="8" font-weight="black" text-anchor="middle" fill="#2D1D19">1</text>
    </g>

    <!-- FLOW 1 -> 2 -->
    <path d="M180,200 L280,200" stroke="var(--color-accent)" stroke-width="2" stroke-dasharray="6 4" marker-end="url(#arrowhead)" class="anim-dash" />
    <text x="230" y="190" font-family="monospace" font-size="9" text-anchor="middle" fill="var(--color-accent)" opacity="0.8">JSON-RPC</text>

    <!-- STEP 2: PROTOCOL -->
    <g class="step-2">
      <rect x="300" y="160" width="180" height="80" rx="12" fill="var(--color-accent)" opacity="0.1" stroke="var(--color-accent)" stroke-width="1" />
      <path d="M300,200 L480,200" stroke="var(--color-accent)" stroke-width="4" opacity="0.2" />
      <text x="390" y="205" font-family="monospace" font-size="12" font-weight="900" text-anchor="middle" fill="var(--color-accent)">TRANSPORT LAYER</text>
      <circle cx="315" cy="175" r="8" fill="var(--color-accent)" />
      <text x="315" y="178" font-family="monospace" font-size="8" font-weight="black" text-anchor="middle" fill="#2D1D19">2</text>
    </g>

    <!-- FLOW 2 -> 3 -->
    <path d="M480,200 L580,200" stroke="var(--color-accent)" stroke-width="2" marker-end="url(#arrowhead)" />

    <!-- STEP 3: SERVERS -->
    <g class="step-3">
      <!-- GitHub -->
      <rect x="600" y="50" width="150" height="70" rx="12" fill="#2D1D19" stroke="var(--color-accent)" stroke-width="1.5" />
      <text x="675" y="90" font-family="monospace" font-size="12" font-weight="bold" text-anchor="middle" fill="white">GITHUB_MCP</text>
      
      <!-- Database -->
      <rect x="600" y="165" width="150" height="70" rx="12" fill="#2D1D19" stroke="var(--color-accent)" stroke-width="1.5" />
      <text x="675" y="205" font-family="monospace" font-size="12" font-weight="bold" text-anchor="middle" fill="white">SQL_SERVER</text>

      <!-- Local -->
      <rect x="600" y="280" width="150" height="70" rx="12" fill="#2D1D19" stroke="var(--color-accent)" stroke-width="1.5" />
      <text x="675" y="320" font-family="monospace" font-size="12" font-weight="bold" text-anchor="middle" fill="white">FILESYSTEM</text>

      <circle cx="615" cy="65" r="8" fill="var(--color-accent)" />
      <text x="615" y="68" font-family="monospace" font-size="8" font-weight="black" text-anchor="middle" fill="#2D1D19">3</text>
    </g>

    <!-- Labels -->
    <text x="390" y="380" font-family="serif" font-style="italic" font-size="12" text-anchor="middle" fill="var(--color-text-secondary)" opacity="0.7">
      "The host no longer needs custom connectors. It speaks one language to all resources."
    </text>
  </svg>
</div>

<style>
  .anim-dash {
    animation: dash-anim 20s linear infinite;
    stroke-dashoffset: 1000;
    stroke-dasharray: 10;
  }
  @keyframes dash-anim {
    to { stroke-dashoffset: 0; }
  }
</style>
