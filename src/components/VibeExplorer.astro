---
---
<div class="vibe-explorer-container my-24 p-1 rounded-3xl bg-gradient-to-br from-accent/20 to-transparent">
  <div class="bg-background border-2 border-ink/10 rounded-[1.4rem] p-8 md:p-12 relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url('https://www.transparenttextures.com/patterns/paper-fibers.png');"></div>

    <header class="max-w-xl mb-12 relative z-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-2.5 h-2.5 rounded-full bg-accent animate-pulse"></span>
        <span class="font-mono text-[10px] tracking-[0.3em] text-ink-faded uppercase font-bold">Mental Model Visualizer</span>
      </div>
      <h3 class="text-3xl md:text-4xl font-serif italic text-ink mb-4 leading-tight">
        The Vibe-Spec <span class="relative inline-block">
          Equilibrium
          <svg class="absolute -bottom-2 left-0 w-full h-2 text-accent/60" viewBox="0 0 100 10" preserveAspectRatio="none">
            <path d="M0,5 Q25,0 50,5 T100,5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </span>
      </h3>
      <p class="text-sm text-text-secondary font-serif italic leading-relaxed">
        "Vibe coding isn't just chatting. It's the calculated management of intent fluidity against deterministic boundaries. Use this to understand the drift."
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 relative z-10">
      <div class="space-y-12">
        <div class="space-y-6">
          <div class="flex justify-between items-end">
            <label class="font-mono text-[11px] uppercase tracking-widest text-ink font-black">Intent Fluidity (Vibe)</label>
            <span id="vibe-val" class="font-mono text-xl font-bold text-accent">20%</span>
          </div>
          <div class="relative h-12 flex items-center">
             <input type="range" min="0" max="100" value="20" class="vibe-slider-pro w-full cursor-none" id="vibe-slider" />
             <div id="vibe-cursor" class="absolute pointer-events-none w-6 h-6 border-2 border-ink bg-accent rounded-full shadow-[4px_4px_0px_rgba(45,29,25,1)] flex items-center justify-center transition-transform active:scale-95">
                <div class="w-1 h-1 bg-ink rounded-full"></div>
             </div>
          </div>
          <div class="flex justify-between font-mono text-[8px] text-ink-faded uppercase tracking-tighter font-bold">
            <span>STRICT SPEC (COMMAND)</span>
            <span>PURE DRIFT (INTENT)</span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-6">
          <div class="p-6 rounded-2xl bg-accent/5 border border-accent/10">
            <span class="block font-mono text-[9px] text-ink-faded mb-2 uppercase font-bold tracking-widest">Hallucination Risk</span>
            <div id="risk-status" class="text-xl font-serif italic text-ink font-bold transition-colors">Nominal</div>
          </div>
          <div class="p-6 rounded-2xl bg-ink text-background border border-ink shadow-xl">
            <span class="block font-mono text-[9px] text-background/50 mb-2 uppercase font-bold tracking-widest">Agent Autonomy</span>
            <div id="autonomy-status" class="text-xl font-serif italic font-bold">Guided</div>
          </div>
        </div>
      </div>

      <div class="relative min-h-[240px] bg-paper-warm/20 rounded-2xl border-2 border-dashed border-ink/10 p-8 flex flex-col justify-between overflow-hidden group">
         <div class="absolute top-4 right-4 font-mono text-[9px] text-ink/20 font-black">MODEL_INTERNAL_STATE</div>
         
         <div id="output-log" class="font-mono text-[11px] leading-relaxed text-ink/70 space-y-2">
            <div class="text-accent-dim">> ANALYZING INTENT VECTORS...</div>
            <div class="opacity-40">> STATUS: EQUILIBRIUM MAINTAINED.</div>
         </div>

         <div class="mt-8 border-t border-ink/5 pt-6">
            <div class="flex items-center gap-2 mb-3">
               <div class="w-2 h-2 rounded-full bg-[#06D6A0]"></div>
               <span class="font-mono text-[10px] uppercase font-bold tracking-widest text-ink/60">Strategy Recommendation</span>
            </div>
            <div id="tool-rec" class="text-sm font-serif italic text-ink leading-snug font-medium">
               "Tighten specs. Use MUSU Warden for deterministic validation."
            </div>
         </div>
      </div>
    </div>
  </div>
</div>

<style>
  .vibe-slider-pro {
    -webkit-appearance: none;
    width: 100%;
    height: 4px;
    background: rgba(45, 29, 25, 0.08);
    outline: none;
    border-radius: 2px;
  }
  .vibe-slider-pro::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 24px;
    height: 24px;
    opacity: 0;
    cursor: none;
  }
</style>

<script>
  function initProExplorer() {
    const slider = document.getElementById('vibe-slider') as HTMLInputElement;
    const cursor = document.getElementById('vibe-cursor');
    const valText = document.getElementById('vibe-val');
    const riskText = document.getElementById('risk-status');
    const autoText = document.getElementById('autonomy-status');
    const log = document.getElementById('output-log');
    const tool = document.getElementById('tool-rec');

    if (!slider || !cursor || !valText || !riskText || !autoText || !log || !tool) return;

    const updateUI = () => {
      const val = parseInt(slider.value);
      const percent = (val / 100) * (slider.offsetWidth - 24);
      cursor.style.left = `${percent}px`;
      valText.innerText = `${val}%`;

      if (val < 35) {
        riskText.innerText = "Nominal";
        riskText.style.color = "inherit";
        autoText.innerText = "Guided";
        log.innerHTML = `<div class="text-accent-dim">> INTENT: CRYSTAL CLEAR</div><div class="opacity-40">> BUFFER: OPTIMAL</div>`;
        tool.innerText = '"Tighten specs. Use MUSU Warden for deterministic validation."';
      } else if (val < 75) {
        riskText.innerText = "Elevated";
        riskText.style.color = "#FFD166";
        autoText.innerText = "Collaborative";
        log.innerHTML = `<div class="text-yellow-600/70">> CAUTION: FLUID INTENT</div><div class="opacity-40">> MODE: ADAPTIVE PROMPTING</div>`;
        tool.innerText = '"Introduce fail-fast loops. Validate every agent step manually."';
      } else {
        riskText.innerText = "CRITICAL";
        riskText.style.color = "#EF476F";
        autoText.innerText = "AUTONOMOUS";
        log.innerHTML = `<div class="text-red-500/80">> DANGER: HIGH DRIFT</div><div class="opacity-40">> SYSTEM: ARCHITECTURAL LOCK</div>`;
        tool.innerText = '"Abandon vibe. Re-write the spec from scratch. Halt dispatch."';
      }
    };

    slider.addEventListener('input', updateUI);
    window.addEventListener('resize', updateUI);
    updateUI();
  }

  initProExplorer();
  document.addEventListener('astro:after-swap', initProExplorer);
</script>
