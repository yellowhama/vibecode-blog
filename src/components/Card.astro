---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;
const { title, description, featured, ogImage, ...props } = data;
const cardClass = featured ? "blog-card-featured" : "blog-card";

// Ensure we have a valid image path. If ogImage is missing, use a fallback based on the slug.
const thumbnail = ogImage ? ogImage : `/images/blog/${id.split('/').pop().replace('.md', '')}/hero.png`;
---

<li class="list-none group">
  <a
    href={getPath(id, filePath)}
    class:list={[cardClass, "block no-underline flex flex-col md:flex-row gap-8 items-start w-full"]}
  >
    <div class="flex-1 w-full">
      <div class="text-mono text-[0.6rem] tracking-widest text-ink-faded uppercase mb-2">{featured ? "Featured" : "Journal Entry"}</div>
      <Heading
        style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
        class="text-2xl md:text-3xl font-serif italic text-ink group-hover:underline decoration-accent/30 leading-tight mb-3"
      >
        {title}
      </Heading>
      <Datetime {...props} class="text-ink-faded" />
      <p class="mt-4 text-base leading-relaxed text-text-secondary line-clamp-3">{description}</p>
    </div>
    
    <div class="w-full md:w-1/3 aspect-[4/3] md:aspect-square border border-ink/10 bg-paper-warm overflow-hidden shrink-0 mt-6 md:mt-0">
      <img 
        src={thumbnail} 
        alt={title} 
        class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity duration-300 mix-blend-multiply"
        onerror="this.src='/images/blog/notebook-sketch.png';"
      />
    </div>
  </a>
</li>
