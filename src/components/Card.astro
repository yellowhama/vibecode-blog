---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;
const { title, description, featured, ogImage, series, workflow, references, ...props } = data;
const cardClass = featured ? "blog-card-featured" : "blog-card";
const seriesLabel = series ?? "Field Log";

const getPlaceholder = (slug: string) => {
  const hashes = slug.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const variants = ['blueprint', 'sketch', 'wiring', 'manuscript', 'gear'];
  const variant = variants[hashes % variants.length];
  return `/images/placeholders/${variant}.png`;
};

const thumbnail = ogImage && ogImage !== "" ? ogImage : getPlaceholder(id);
---

<li
  class="list-none group border-b border-border py-12 first:pt-0"
  data-article-card
  data-post-slug={id}
>
  <a
    href={getPath(id, filePath)}
    class:list={[cardClass, "group flex flex-col md:flex-row gap-8 items-center no-underline reveal-on-scroll"]}
  >
    <!-- Image on Left -->
    <div class="w-full md:w-2/5 aspect-[4/3] border border-border bg-bg-secondary rounded-lg overflow-hidden relative shrink-0">
      <img src={thumbnail} alt={title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" onerror="this.src='/images/blog/notebook-sketch.png';" />
    </div>
    
    <!-- Text on Right -->
    <div class="w-full md:w-3/5 flex flex-col gap-3">
      <div class="flex items-center gap-3">
        <span class="font-mono text-[0.6rem] font-medium uppercase tracking-widest text-accent">
          {seriesLabel}
        </span>
        <span class="w-1 h-1 rounded-full bg-border"></span>
        <span class="font-mono text-[0.6rem] tracking-widest text-text-muted">
          {references?.length ?? 0} References
        </span>
      </div>
      <Heading
        style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
        class="text-3xl font-semibold text-foreground group-hover:text-accent transition-colors leading-tight"
      >
        {title}
      </Heading>
      <Datetime {...props} class="text-xs font-mono text-text-muted uppercase tracking-widest mt-2" />
      <p class="text-text-secondary leading-relaxed text-lg mt-2 line-clamp-3">
        {description}
      </p>
    </div>
  </a>
</li>
