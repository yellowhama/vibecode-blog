---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";
import referenceCeiling from "@/data/reference-ceiling-scores.json";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;
const { title, description, featured, ogImage, series, workflow, references, ...props } = data;
const cardClass = featured ? "blog-card-featured" : "blog-card";
const seriesLabel = series ?? "Field Journal";
const ceilingScore = referenceCeiling.posts[id as keyof typeof referenceCeiling.posts]?.score;
const proofBadges = [
  ceilingScore ? `Reference ceiling ${ceilingScore}` : null,
  workflow === "packet" ? "Source packet" : "About context",
  `${references?.length ?? 0} source refs`,
  "Unique image",
  "Rendered proof",
  "Hash approval",
].filter(Boolean);

// Ensure we have a valid image path. If ogImage is missing, use a fallback based on the slug.

// Advanced Placeholder Strategy
const getPlaceholder = (slug: string) => {
  const hashes = slug.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const variants = ['blueprint', 'sketch', 'wiring', 'manuscript', 'gear'];
  const variant = variants[hashes % variants.length];
  return `/images/placeholders/${variant}.png`;
};

const thumbnail = ogImage && ogImage !== "" ? ogImage : getPlaceholder(id);

---

<li
  class="list-none group"
  data-evidence-card
  data-post-slug={id}
  data-image-contract={thumbnail}
  data-reference-score={ceilingScore ?? 0}
  data-source-count={references?.length ?? 0}
>
  <a
    href={getPath(id, filePath)}
    class:list={[cardClass, "block no-underline flex flex-col md:flex-row gap-8 items-start w-full"]}
  >
    <div class="flex-1 w-full">
      <div class="text-mono text-[0.6rem] tracking-widest text-ink-faded uppercase mb-2">{featured ? "Featured" : "Journal Entry"} / {seriesLabel}</div>
      <Heading
        style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
        class="text-2xl md:text-3xl font-serif italic text-ink group-hover:underline decoration-accent/30 leading-tight mb-3"
      >
        {title}
      </Heading>
      <Datetime {...props} class="text-ink-faded" />
      <p class="mt-4 text-base leading-relaxed text-text-secondary line-clamp-3">{description}</p>
      <p class="mt-3 max-w-2xl font-mono text-[0.56rem] font-bold uppercase tracking-[0.14em] text-ink-faded">
        Surfaced because: {workflow === "packet" ? "source packet" : "site context"} / {ceilingScore ? `reference ceiling ${ceilingScore}` : "unscored"} / {references?.length ?? 0} source refs / rendered image proof.
      </p>
      <div class="mt-5 flex flex-wrap gap-2 font-mono text-[0.54rem] font-bold uppercase tracking-[0.14em] text-ink-faded" aria-label="Publication proof status">
        {proofBadges.map(badge => (
          <span class="border border-ink/10 bg-background px-2 py-1">{badge}</span>
        ))}
      </div>
    </div>
    
    <div class="relative order-first w-full aspect-[4/3] overflow-hidden border border-ink/10 bg-paper-warm shadow-sm transition-colors duration-500 group-hover:border-accent/40 md:order-none md:mt-0 md:w-1/3 md:shrink-0 md:aspect-square">
      <div class="absolute inset-0 bg-paper-texture opacity-20 pointer-events-none mix-blend-overlay"></div>
      <img 
        src={thumbnail} 
        alt={title} 
        class="w-full h-full object-contain p-2 opacity-95 group-hover:opacity-100 transition-opacity duration-300"
        onerror="this.src='/images/blog/notebook-sketch.png';"
      />
    </div>
  </a>
</li>
