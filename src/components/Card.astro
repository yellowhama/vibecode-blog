---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, featured, ...props } = data;
const cardClass = featured ? "musu-card-featured" : "musu-card";
---

<li class="my-6 list-none">
  <a
    href={getPath(id, filePath)}
    class:list={[cardClass, "interactive block p-5 no-underline"]}
  >
    <Heading
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
      class:list={[
        "text-lg font-bold sm:text-xl",
        featured ? "text-[var(--border-strong)]" : "text-foreground",
      ]}
    >
      {title}
    </Heading>
    <Datetime {...props} class="mt-2" />
    <p class:list={[
      "mt-2 text-sm leading-relaxed",
      featured ? "text-[var(--border-strong)] opacity-80" : "text-text-secondary",
    ]}>{description}</p>
  </a>
</li>
