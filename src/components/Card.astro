---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, featured, ...props } = data;
const cardClass = featured ? "blog-card-featured" : "blog-card";
---

<li class="list-none">
  <a
    href={getPath(id, filePath)}
    class:list={[cardClass, "block no-underline"]}
  >
    <Heading
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
      class="text-lg font-semibold sm:text-xl text-foreground"
    >
      {title}
    </Heading>
    <Datetime {...props} class="mt-2" />
    <p class="mt-2 text-sm leading-relaxed text-text-secondary">{description}</p>
  </a>
</li>
