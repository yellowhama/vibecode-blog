---
---
<div class="soft3-diagram my-16 p-8 bg-[#FDFCF0] rounded-3xl border-[3px] border-ink/10 relative overflow-hidden group">
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url('https://www.transparenttextures.com/patterns/paper-fibers.png');"></div>

  <!-- Header -->
  <div class="flex justify-between items-center mb-12 relative z-10 border-b border-ink/5 pb-6">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg bg-ink flex items-center justify-center shadow-lg">
         <span class="font-serif text-background italic font-black text-xs">S3</span>
      </div>
      <h4 class="text-xl font-serif italic text-ink uppercase tracking-tighter">Fig 2.1: The Software 3.0 Operating Model</h4>
    </div>
    <div class="flex items-center gap-2">
       <span class="px-2 py-0.5 rounded-full bg-ink/5 text-ink/40 text-[8px] font-mono tracking-widest font-black uppercase italic">Guru Deconstruction</span>
    </div>
  </div>

  <!-- Diagram SVG -->
  <svg viewBox="0 0 800 500" class="relative z-10 w-full h-auto">
    <!-- LAYER 3: AGENTIC APPS -->
    <g class="layer-3">
      <rect x="100" y="50" width="600" height="80" rx="20" fill="var(--color-accent)" stroke="#2D1D19" stroke-width="2" />
      <text x="400" y="95" font-family="serif" font-size="18" font-style="italic" font-weight="900" text-anchor="middle" fill="#2D1D19">AGENTIC INTERFACE (INTENT)</text>
      <circle cx="120" cy="70" r="10" fill="#2D1D19" />
      <text x="120" y="74" font-family="monospace" font-size="10" font-weight="black" text-anchor="middle" fill="white">3</text>
    </g>

    <!-- CONNECTOR 2 -> 3 -->
    <path d="M400,130 L400,180" stroke="#2D1D19" stroke-width="2" stroke-dasharray="4 4" />
    <text x="415" y="160" font-family="serif" font-style="italic" font-size="11" fill="#2D1D19" opacity="0.6">"Natural Language Programs"</text>

    <!-- LAYER 2: LLM KERNEL -->
    <g class="layer-2">
      <rect x="100" y="180" width="600" height="120" rx="20" fill="#2D1D19" stroke="#2D1D19" stroke-width="2" />
      <text x="400" y="235" font-family="monospace" font-size="20" font-weight="900" text-anchor="middle" fill="var(--color-accent)">LLM KERNEL (REASONING)</text>
      <text x="400" y="265" font-family="serif" font-size="12" font-style="italic" text-anchor="middle" fill="var(--color-accent)" opacity="0.7">Memory (KV Cache) | Scheduling | I/O (MCP)</text>
      <circle cx="120" cy="200" r="10" fill="var(--color-accent)" />
      <text x="120" y="204" font-family="monospace" font-size="10" font-weight="black" text-anchor="middle" fill="#2D1D19">2</text>
    </g>

    <!-- CONNECTOR 1 -> 2 -->
    <path d="M400,300 L400,350" stroke="#2D1D19" stroke-width="2" stroke-dasharray="4 4" />
    <text x="415" y="330" font-family="serif" font-style="italic" font-size="11" fill="#2D1D19" opacity="0.6">"Differentiable Weights"</text>

    <!-- LAYER 1: HARDWARE -->
    <g class="layer-1">
      <rect x="100" y="350" width="600" height="80" rx="20" fill="white" stroke="#2D1D19" stroke-width="2" />
      <text x="400" y="395" font-family="serif" font-size="18" font-style="italic" font-weight="900" text-anchor="middle" fill="#2D1D19">RAW COMPUTE (GPU / H100)</text>
      <circle cx="120" cy="370" r="10" fill="#2D1D19" />
      <text x="120" y="374" font-family="monospace" font-size="10" font-weight="black" text-anchor="middle" fill="white">1</text>
    </g>

    <!-- Sideways Label: Comparison -->
    <g transform="translate(50, 250) rotate(-90)">
       <text x="0" y="0" font-family="monospace" font-size="10" font-weight="bold" fill="#2D1D19" opacity="0.3" letter-spacing="0.5em">SOFTWARE 3.0 STACK</text>
    </g>
  </svg>

  <!-- Footnote -->
  <div class="mt-8 pt-6 border-t border-ink/5">
     <p class="font-serif italic text-ink/60 text-sm leading-relaxed text-center">
       "In Software 3.0, the human role shifts from writing logic to curating context for the kernel."
     </p>
  </div>
</div>
