---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import referenceCeiling from "@/data/reference-ceiling-scores.json";
import writingPulse from "@/data/writing-pulse-scores.json";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return paginate(getSortedPosts(posts), { pageSize: SITE.postPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const totalPosts = page.data.length;
const packetBackedPosts = page.data.filter(post => post.data.workflow === "packet").length;
const renderedViewportChecks = totalPosts * 2 + 4;
const approvalRecords = totalPosts;
const getReferenceCeiling = (slug: string) =>
  referenceCeiling.posts[slug as keyof typeof referenceCeiling.posts]?.score;
const getWritingPulse = (slug: string) =>
  writingPulse.posts[slug as keyof typeof writingPulse.posts]?.score;
const getEvidenceStrength = (post: (typeof page.data)[number]) => {
  const referenceScore = getReferenceCeiling(post.id) ?? 0;
  const pulseScore = getWritingPulse(post.id) ?? 0;
  const sourceScore = Math.min(post.data.references?.length ?? 0, 6) * 3;
  const featuredBonus = post.data.featured ? 2 : 0;
  return referenceScore + pulseScore + sourceScore + featuredBonus;
};
const leadPost = [...page.data]
  .filter(post => post.data.workflow === "packet" && post.data.ogImage)
  .sort((a, b) => getEvidenceStrength(b) - getEvidenceStrength(a))[0];
const leadReferenceScore = leadPost ? getReferenceCeiling(leadPost.id) : undefined;
const leadWritingPulseScore = leadPost ? getWritingPulse(leadPost.id) : undefined;
const leadSourceCount = leadPost?.data.references?.length ?? 0;
const leadEvidenceStrength = leadPost ? getEvidenceStrength(leadPost) : 0;
const leadProofRows = leadPost
  ? [
      { label: "Why first", value: `Evidence rank 1 by reference ceiling, writing pulse, and source count; strength ${leadEvidenceStrength}.` },
      { label: "Writing pulse", value: `${leadWritingPulseScore ?? "n/a"} average gate ${writingPulse.averageScore}; weak posts remain queued for revision.` },
      { label: "Evidence", value: `${leadSourceCount} source refs, source packet workflow, rendered screenshot contract.` },
      { label: "Image", value: "The thumbnail must match the slug-specific image contract in the first screen." },
      { label: "Approval", value: "The post remains public only while current Markdown hash approval agrees." },
    ]
  : [];
---

<Layout title={`Posts | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle="Posts"
    pageDesc="Evidence-backed articles only. Every non-About post is tied to source packets, writing pulse, a unique image contract, rendered screenshots, and a human approval record."
  >
    {leadPost ? (
      <section
        class="mb-10 grid gap-6 border border-ink/10 bg-background p-4 shadow-sm md:grid-cols-[minmax(0,1fr)_22rem] md:items-center"
        aria-label="Featured evidence-backed article"
        data-evidence-card
        data-post-slug={leadPost.id}
        data-image-contract={leadPost.data.ogImage}
        data-reference-score={leadReferenceScore ?? 0}
        data-writing-pulse-score={leadWritingPulseScore ?? 0}
        data-source-count={leadSourceCount}
        data-evidence-strength={leadEvidenceStrength}
        data-evidence-rank="1"
        data-surfacing-reason={`archive-lead-evidence-strength-${leadEvidenceStrength}`}
      >
        <div>
          <div class="mb-4 flex flex-wrap gap-2 font-mono text-[0.56rem] font-bold uppercase tracking-[0.14em] text-ink-faded">
            <span class="border border-ink/10 bg-paper-warm px-2 py-1">Source packet</span>
            {leadReferenceScore ? (
              <span class="border border-ink/10 bg-paper-warm px-2 py-1">Reference ceiling {leadReferenceScore}</span>
            ) : null}
            {leadWritingPulseScore ? (
              <span class="border border-ink/10 bg-paper-warm px-2 py-1">Writing pulse {leadWritingPulseScore}</span>
            ) : null}
            <span class="border border-ink/10 bg-paper-warm px-2 py-1">{leadSourceCount} sources</span>
            <span class="border border-ink/10 bg-paper-warm px-2 py-1">Unique image</span>
            <span class="border border-ink/10 bg-paper-warm px-2 py-1">Rendered proof</span>
            <span class="border border-ink/10 bg-paper-warm px-2 py-1">Hash approval</span>
          </div>
          <a href={`/posts/${leadPost.id}`} class="group no-underline">
            <h2 class="font-serif text-3xl italic leading-tight text-ink group-hover:underline decoration-accent/30">
              {leadPost.data.title}
            </h2>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-text-secondary">{leadPost.data.description}</p>
          </a>
          <dl class="mt-5 grid gap-2 border-y border-ink/10 py-4 sm:grid-cols-2">
            {leadProofRows.map(row => (
              <div>
                <dt class="font-mono text-[0.52rem] font-black uppercase tracking-[0.14em] text-ink-faded">{row.label}</dt>
                <dd class="mt-1 text-xs leading-relaxed text-text-secondary">{row.value}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-4 max-w-2xl font-mono text-[0.58rem] uppercase tracking-[0.16em] text-ink-faded">
            Evidence receipt: evidence rank 1 / strength {leadEvidenceStrength} / reference ceiling {leadReferenceScore ?? "n/a"} / writing pulse {leadWritingPulseScore ?? "n/a"} / source packet / unique image / rendered screenshots / current approval hash.
          </p>
          <p class="mt-2 max-w-2xl font-mono text-[0.56rem] uppercase tracking-[0.14em] text-ink-faded">
            Why this is first: the card exposes its score, source count, image contract, rendered proof, and approval state before the click.
          </p>
        </div>
        <a href={`/posts/${leadPost.id}`} class="order-first block no-underline md:order-none">
          <img src={leadPost.data.ogImage} alt={leadPost.data.title} class="aspect-[16/9] w-full border border-ink/10 bg-paper-warm object-contain p-2" />
        </a>
      </section>
    ) : null}
    <section class="mb-10 border-y border-ink/10 bg-accent/5 py-6" aria-label="Archive proof status">
      <div class="grid gap-4 sm:grid-cols-6">
        <div>
          <p class="font-mono text-[0.58rem] uppercase tracking-[0.18em] text-ink-faded">Visible posts</p>
          <p class="mt-1 font-mono text-2xl font-black text-ink">{totalPosts}</p>
        </div>
        <div>
          <p class="font-mono text-[0.58rem] uppercase tracking-[0.18em] text-ink-faded">Packet-backed</p>
          <p class="mt-1 font-mono text-2xl font-black text-ink">{packetBackedPosts}</p>
        </div>
        <div>
          <p class="font-mono text-[0.58rem] uppercase tracking-[0.18em] text-ink-faded">Rendered shots</p>
          <p class="mt-1 font-mono text-2xl font-black text-ink">{renderedViewportChecks}</p>
        </div>
        <div>
          <p class="font-mono text-[0.58rem] uppercase tracking-[0.18em] text-ink-faded">Approvals</p>
          <p class="mt-1 font-mono text-2xl font-black text-ink">{approvalRecords}</p>
        </div>
        <div>
          <p class="font-mono text-[0.58rem] uppercase tracking-[0.18em] text-ink-faded">Ceiling avg</p>
          <p class="mt-1 font-mono text-2xl font-black text-ink">{referenceCeiling.averageScore}</p>
        </div>
        <div>
          <p class="font-mono text-[0.58rem] uppercase tracking-[0.18em] text-ink-faded">Pulse avg</p>
          <p class="mt-1 font-mono text-2xl font-black text-ink">{writingPulse.averageScore}</p>
        </div>
      </div>
      <p class="mt-5 max-w-2xl text-sm leading-relaxed text-text-secondary">
        The archive is intentionally small. A post stays public only when its source workflow, image contract,
        rendered page evidence, and current Markdown approval hash agree.
      </p>
    </section>
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
