---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import referenceCeiling from "@/data/reference-ceiling-scores.json";
import referenceBloggerCeiling from "@/data/reference-blogger-ceiling-scores.json";
import writingPulse from "@/data/writing-pulse-scores.json";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return paginate(getSortedPosts(posts), { pageSize: SITE.postPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const archivePrinciples = [
  { label: "Concrete artifact", value: "The argument has to touch a file, run, screenshot, log, or decision surface." },
  { label: "Source pressure", value: "Outside references are used to sharpen the claim, not to decorate it." },
  { label: "Reusable rule", value: "A good post ends with a test the reader can apply somewhere else." },
];
const getReferenceCeiling = (slug: string) =>
  referenceCeiling.posts[slug as keyof typeof referenceCeiling.posts]?.score;
const getReferenceBloggerCeiling = (slug: string) =>
  referenceBloggerCeiling.posts[slug as keyof typeof referenceBloggerCeiling.posts]?.score;
const getWritingPulse = (slug: string) =>
  writingPulse.posts[slug as keyof typeof writingPulse.posts]?.score;
const getEvidenceStrength = (post: (typeof page.data)[number]) => {
  const bloggerScore = getReferenceBloggerCeiling(post.id) ?? 0;
  const referenceScore = getReferenceCeiling(post.id) ?? 0;
  const pulseScore = getWritingPulse(post.id) ?? 0;
  const sourceScore = Math.min(post.data.references?.length ?? 0, 6) * 3;
  const featuredBonus = post.data.featured ? 2 : 0;
  return bloggerScore + referenceScore + pulseScore + sourceScore + featuredBonus;
};
const leadPost = [...page.data]
  .filter(post => post.data.workflow === "packet" && post.data.ogImage)
  .sort((a, b) => getEvidenceStrength(b) - getEvidenceStrength(a))[0];
const leadBloggerScore = leadPost ? getReferenceBloggerCeiling(leadPost.id) : undefined;
const leadReferenceScore = leadPost ? getReferenceCeiling(leadPost.id) : undefined;
const leadWritingPulseScore = leadPost ? getWritingPulse(leadPost.id) : undefined;
const leadSourceCount = leadPost?.data.references?.length ?? 0;
const leadEvidenceStrength = leadPost ? getEvidenceStrength(leadPost) : 0;
const leadProofRows = leadPost
  ? [
      { label: "Why this one", value: "It starts with a concrete artifact and turns the source material into a usable operating rule." },
      { label: "Source trail", value: `${leadSourceCount} outside references and a working artifact behind the argument.` },
      { label: "What to inspect", value: "Open the image first, then check whether the essay proves the claim instead of merely naming the trend." },
      { label: "Reader payoff", value: "Each article should leave you with a decision rule you can reuse in your own agent workflow." },
    ]
  : [];
---

<Layout title={`Posts | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle="Posts"
    pageDesc="Evidence-backed articles only. Every non-About post is tied to sources, a concrete artifact, an original visual, and a review pass before publication."
  >
    {leadPost ? (
      <section
        class="mb-10 grid gap-6 border border-ink/10 bg-background p-4 shadow-sm md:grid-cols-[minmax(0,1fr)_22rem] md:items-center"
        aria-label="Featured evidence-backed article"
        data-evidence-card
        data-post-slug={leadPost.id}
        data-image-contract={leadPost.data.ogImage}
        data-reference-blogger-score={leadBloggerScore ?? 0}
        data-reference-score={leadReferenceScore ?? 0}
        data-writing-pulse-score={leadWritingPulseScore ?? 0}
        data-source-count={leadSourceCount}
        data-evidence-strength={leadEvidenceStrength}
        data-evidence-rank="1"
        data-surfacing-reason={`archive-lead-evidence-strength-${leadEvidenceStrength}`}
        data-publication-approved="true"
      >
        <div>
          <div class="mb-4 flex flex-wrap gap-2 font-mono text-[0.56rem] font-bold uppercase tracking-[0.14em] text-ink-faded">
            <span class="border border-ink/10 bg-paper-warm px-2 py-1">Source-backed</span>
            <span class="border border-ink/10 bg-paper-warm px-2 py-1">{leadSourceCount} references</span>
            <span class="border border-ink/10 bg-paper-warm px-2 py-1">Original visual</span>
            <span class="border border-ink/10 bg-paper-warm px-2 py-1">Practical rule</span>
          </div>
          <a href={`/posts/${leadPost.id}`} class="group no-underline">
            <h2 class="font-serif text-3xl italic leading-tight text-ink group-hover:underline decoration-accent/30">
              {leadPost.data.title}
            </h2>
          <p class="mt-4 max-w-2xl text-base leading-relaxed text-text-secondary">{leadPost.data.description}</p>
          </a>
          <dl class="mt-5 grid gap-2 border-y border-ink/10 py-4 sm:grid-cols-2">
            {leadProofRows.map(row => (
              <div>
                <dt class="font-mono text-[0.52rem] font-black uppercase tracking-[0.14em] text-ink-faded">{row.label}</dt>
                <dd class="mt-1 text-xs leading-relaxed text-text-secondary">{row.value}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-4 max-w-2xl font-mono text-[0.58rem] uppercase tracking-[0.16em] text-ink-faded">
            Start here: concrete claim, source trail, original visual, and a reusable decision rule.
          </p>
        </div>
        <a href={`/posts/${leadPost.id}`} class="order-first block no-underline md:order-none">
          <img src={leadPost.data.ogImage} alt={leadPost.data.title} class="aspect-[16/9] w-full border border-ink/10 bg-paper-warm object-contain p-2" />
        </a>
      </section>
    ) : null}
    <section class="mb-10 border-y border-ink/10 bg-accent/5 py-6" aria-label="Archive editorial promise">
      <div class="grid gap-4 sm:grid-cols-3">
        {archivePrinciples.map(principle => (
          <div>
            <p class="font-mono text-[0.58rem] uppercase tracking-[0.18em] text-ink-faded">{principle.label}</p>
            <p class="mt-2 text-sm leading-relaxed text-text-secondary">{principle.value}</p>
          </div>
        ))}
      </div>
      <p class="mt-5 max-w-2xl text-sm leading-relaxed text-text-secondary">
        The archive is intentionally small. The point is not to list every AI trend; it is to make each claim inspectable.
      </p>
    </section>
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
