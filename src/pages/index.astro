---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.slice(0, SITE.postPerIndex);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
---

<Layout
  title="vibecode — vibe coding in practice"
  description="What works, what breaks, what I learned. Practical notes on building with AI agents."
>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="pt-8 pb-6">
      <h1 class="text-2xl font-bold text-foreground">vibecode</h1>
      <p class="mt-2 text-text-secondary">
        Vibe coding in practice. What works, what breaks, what I learned.
      </p>
    </section>

    {featuredPosts.length > 0 && (
      <section class="pb-6">
        <h2 class="text-lg font-semibold text-foreground mb-4">Featured</h2>
        <ul>
          {featuredPosts.map(data => <Card {...data} />)}
        </ul>
      </section>
    )}

    <section class="pb-8">
      <h2 class="text-lg font-semibold text-foreground mb-4">Recent Posts</h2>
      <ul>
        {recentPosts.map(data => <Card {...data} />)}
      </ul>
    </section>

    <div class="py-4 text-center">
      <a href="/posts/" class="text-accent hover:underline">
        All posts →
      </a>
    </div>
  </main>
  <Footer />
</Layout>
