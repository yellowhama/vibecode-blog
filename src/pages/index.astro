---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.slice(0, SITE.postPerIndex);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
---

<Layout
  title="vibecode — field notes from a vibe coding castaway"
  description="I started vibe coding six months ago with zero programming background. The project hit 10,847 lines I couldn't explain. These are the field notes."
>
  <Header />

  <!-- Hero — full-bleed island map -->
  <section class="hero">
    <div class="hero-meta">
      <span class="hero-meta-label">FIELD JOURNAL</span>
      <span class="hero-meta-rule"></span>
      <span class="hero-meta-coords">lat. unknown.  long. unknown.</span>
    </div>
    <h1 class="hero-title">
      I washed up on the island of <em>vibe coding</em>.
    </h1>
    <p class="hero-tagline">
      Zero programming background. Six months in. 10,847 lines I couldn't explain.<br>
      These are the field notes.
    </p>
    <a href="/posts/" class="hero-cta">Read the field journal →</a>
    <figure class="hero-figure">
      <img src="/images/about/island-map.png" alt="The island — camp, wiki warehouse, scout outpost, tools, and the unexplored web" />
      <figcaption>An incomplete map. I'm still finding the edges.</figcaption>
    </figure>
  </section>

  <main id="main-content" class="app-layout">
    {featuredPosts.length > 0 && (
      <section class="pb-10">
        <header class="section-header">
          <span class="section-eyebrow">FEATURED</span>
          <h2 class="section-title">Start here.</h2>
        </header>
        <ul>
          {featuredPosts.map(data => <Card {...data} />)}
        </ul>
      </section>
    )}

    <section class="pb-10">
      <header class="section-header">
        <span class="section-eyebrow">LATEST</span>
        <h2 class="section-title">Recent posts.</h2>
      </header>
      <ul>
        {recentPosts.map(data => <Card {...data} />)}
      </ul>
      <div class="pt-4">
        <a href="/posts/" class="text-accent hover:underline">
          All posts →
        </a>
      </div>
    </section>

    <!-- Manifesto / about strip -->
    <section class="manifesto">
      <p>
        Not a tutorial. Not a success story. Not <em>"10 tips from an AI expert."</em>
      </p>
      <p>
        I'm building a real product called <a href="https://github.com/yellowhama/musu-bee">MUSU</a> — a system that runs AI coding agents across multiple machines.
        It is not finished. Things break every day. I fix them. They break again.
        I write down what happened.
      </p>
      <p class="manifesto-foot">
        — for the person I was three months ago.
      </p>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .hero {
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
    padding: 3rem 1rem 4rem;
    text-align: center;
  }
  @media (min-width: 768px) {
    .hero { padding: 4.5rem 2rem 5rem; }
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    font-family: ui-monospace, "IBM Plex Mono", "JetBrains Mono", monospace;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
  .hero-meta-rule {
    flex: 0 0 1.5rem;
    height: 1px;
    background: var(--border-strong);
  }

  .hero-title {
    font-family: var(--font-app);
    font-size: clamp(2rem, 6vw, 3.75rem);
    font-weight: 400;
    line-height: 1.1;
    color: var(--foreground);
    max-width: 56rem;
    margin: 0 auto 1.5rem;
  }
  .hero-title em {
    font-style: italic;
    color: var(--accent-dim);
  }

  .hero-tagline {
    font-family: var(--font-app);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 38rem;
    margin: 0 auto 2.25rem;
  }

  .hero-cta {
    display: inline-block;
    font-family: ui-monospace, "IBM Plex Mono", monospace;
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--foreground);
    background: var(--background);
    border: 2px solid var(--foreground);
    padding: 0.85rem 1.6rem;
    text-decoration: none;
    box-shadow: 6px 6px 0 0 var(--foreground);
    transition: transform 120ms ease, box-shadow 120ms ease;
  }
  .hero-cta:hover {
    transform: translate(2px, 2px);
    box-shadow: 4px 4px 0 0 var(--foreground);
  }

  .hero-figure {
    margin: 4rem auto 0;
    max-width: min(72rem, calc(100vw - 2rem));
  }
  .hero-figure img {
    width: 100%;
    height: auto;
    border: 3px solid var(--foreground);
    box-shadow: 10px 10px 0 0 var(--foreground);
    background: var(--background);
    display: block;
  }
  .hero-figure figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-app);
    font-size: 0.875rem;
    font-style: italic;
    color: var(--text-muted);
    text-align: center;
  }

  /* Section headers */
  .section-header {
    margin-bottom: 1.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }
  .section-eyebrow {
    display: block;
    font-family: ui-monospace, "IBM Plex Mono", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }
  .section-title {
    font-family: var(--font-app);
    font-size: 1.75rem;
    font-weight: 400;
    color: var(--foreground);
    margin: 0;
  }

  /* Manifesto strip */
  .manifesto {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    padding: 2.5rem 1.5rem;
    margin: 2rem 0 3rem;
    font-family: var(--font-app);
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--foreground);
  }
  .manifesto p { margin: 0 0 1rem; }
  .manifesto p:last-child { margin: 0; }
  .manifesto em { font-style: italic; color: var(--text-secondary); }
  .manifesto a {
    color: var(--accent-dim);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .manifesto-foot {
    font-family: ui-monospace, "IBM Plex Mono", monospace;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    margin-top: 1.5rem !important;
  }
</style>
