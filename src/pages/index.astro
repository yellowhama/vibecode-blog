---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import Footer from "@/components/Footer.astro";
import getSortedPosts from "@/utils/getSortedPosts";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);
const sliderPosts = sortedPosts.slice(0, 5);
const recentPosts = sortedPosts;
---

<Layout
  title="vibecode | Field notes for agentic software"
  description="Field notes for people shipping software with agents: real artifacts, broken runs, design contracts, and operating rules."
>
  <Header />

  <main id="main-content">
    <header class="relative min-h-[90vh] flex flex-col justify-center pt-32 pb-24 mb-0 overflow-hidden border-b border-border bg-background">
      <!-- Hero Town Background -->
      <div class="absolute inset-0 w-full h-full">
        <img src="/images/hero.png" alt="VibeCode Town Background" class="w-full h-full object-cover opacity-20 mix-blend-luminosity" />
      </div>
      
      <!-- Gradient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-background via-background/90 to-background/30"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-background"></div>

      <div class="app-layout relative z-10 w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left: Solopreneur Text (Static) -->
        <div class="lg:col-span-7 flex flex-col items-start text-left animate-fade-in-up">
          <div class="inline-flex items-center gap-3 px-3 py-1 mb-8 text-[0.7rem] font-mono tracking-widest uppercase border rounded-full border-border bg-bg-secondary/50 text-text-secondary">
            <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
            The 1-Person Unicorn
          </div>
          
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-semibold tracking-tighter leading-tight mb-8">
            Scaling your solopreneur business with <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-accent-dim drop-shadow-sm">autonomous agents</span>.
          </h1>
          
          <p class="text-lg md:text-xl text-text-secondary max-w-xl leading-relaxed mb-10">
            Real artifacts, production workflows, and AEO-ready frameworks. 
            Copy our systems to build a 10-person business, alone.
          </p>

          <div class="flex gap-4">
            <a href="/about/" class="px-6 py-3 text-sm font-medium transition-colors border rounded-md bg-bg-secondary/80 border-border hover:border-border-strong text-foreground backdrop-blur-sm">
              About the Project
            </a>
          </div>
        </div>

        <!-- Right: Rotating Post Cards (Dynamic) -->
        <div class="lg:col-span-5 relative w-full max-w-md mx-auto lg:mx-0 lg:ml-auto aspect-[3/4] mt-12 lg:mt-0 animate-fade-in-up delay-200 perspective-1000">
          <div class="w-full h-full relative group" id="hero-post-rotator">
            
            {sliderPosts.map((post, i) => (
              <div class={`absolute inset-0 transition-all duration-1000 ease-in-out ${i === 0 ? 'opacity-100 translate-y-0 scale-100 z-20' : 'opacity-0 translate-y-8 scale-95 z-10 pointer-events-none'}`} data-rotator-slide={i}>
                <a href={`/posts/${post.id}`} class="block w-full h-full bg-bg-secondary/80 backdrop-blur-md border border-border rounded-2xl overflow-hidden shadow-[0_8px_30px_rgb(0,0,0,0.5)] group-hover:border-accent transition-colors flex flex-col no-underline">
                  <!-- Thumbnail Container (1:1 Aspect Ratio Preserved inside a flex box) -->
                  <div class="w-full aspect-square relative overflow-hidden bg-background border-b border-border shrink-0">
                    <img src={post.data.ogImage || "/images/hero.png"} alt={post.data.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                    <div class="absolute inset-0 bg-gradient-to-t from-bg-secondary/80 via-transparent to-transparent"></div>
                    <div class="absolute top-4 left-4">
                      <span class="px-3 py-1 text-[0.65rem] font-bold uppercase tracking-widest text-background bg-foreground rounded-full shadow-lg">
                        {post.data.series ?? "Field Log"}
                      </span>
                    </div>
                  </div>
                  <!-- Text Content -->
                  <div class="p-6 flex-1 flex flex-col justify-center">
                    <h3 class="text-xl md:text-2xl font-bold tracking-tight text-foreground group-hover:text-accent transition-colors line-clamp-2 mb-3 leading-snug">
                      {post.data.title}
                    </h3>
                    <p class="text-sm text-text-secondary line-clamp-2">
                      {post.data.description}
                    </p>
                  </div>
                </a>
              </div>
            ))}

            <!-- Mini Controls for Slider -->
            <div class="absolute -bottom-16 right-0 flex items-center gap-4 z-30">
              <button id="rotator-prev" class="w-10 h-10 flex items-center justify-center rounded-full border border-border bg-bg-secondary/80 hover:bg-foreground hover:text-background transition-colors backdrop-blur-sm" aria-label="Previous Post">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
              </button>
              <div class="flex gap-2" id="rotator-dots">
                {sliderPosts.map((_, i) => (
                  <button class={`w-2 h-2 rounded-full transition-colors ${i === 0 ? 'bg-foreground' : 'bg-border hover:bg-foreground/50'}`} data-rotator-dot={i} aria-label={`Go to post ${i + 1}`}></button>
                ))}
              </div>
              <button id="rotator-next" class="w-10 h-10 flex items-center justify-center rounded-full border border-border bg-bg-secondary/80 hover:bg-foreground hover:text-background transition-colors backdrop-blur-sm" aria-label="Next Post">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
              </button>
            </div>
            
          </div>
        </div>
      </div>

      <script>
        document.addEventListener("DOMContentLoaded", () => {
          const slides = document.querySelectorAll("[data-rotator-slide]");
          const dots = document.querySelectorAll("[data-rotator-dot]");
          const prevBtn = document.getElementById("rotator-prev");
          const nextBtn = document.getElementById("rotator-next");
          
          if (!slides.length) return;

          let currentIndex = 0;
          const totalSlides = slides.length;
          let interval;

          const updateSlider = () => {
            slides.forEach((slide, idx) => {
              if (idx === currentIndex) {
                slide.className = "absolute inset-0 transition-all duration-1000 ease-in-out opacity-100 translate-y-0 scale-100 z-20";
              } else {
                slide.className = "absolute inset-0 transition-all duration-1000 ease-in-out opacity-0 translate-y-8 scale-95 z-10 pointer-events-none";
              }
            });
            
            dots.forEach((dot, idx) => {
              if (idx === currentIndex) {
                dot.className = "w-2 h-2 rounded-full transition-colors bg-foreground";
              } else {
                dot.className = "w-2 h-2 rounded-full transition-colors bg-border hover:bg-foreground/50";
              }
            });
          };

          const nextSlide = () => {
            currentIndex = (currentIndex + 1) % totalSlides;
            updateSlider();
          };

          const prevSlide = () => {
            currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
            updateSlider();
          };

          const startAutoPlay = () => {
            interval = setInterval(nextSlide, 5000);
          };

          const resetAutoPlay = () => {
            clearInterval(interval);
            startAutoPlay();
          };

          if (nextBtn) nextBtn.addEventListener("click", () => { nextSlide(); resetAutoPlay(); });
          if (prevBtn) prevBtn.addEventListener("click", () => { prevSlide(); resetAutoPlay(); });

          dots.forEach((dot, idx) => {
            dot.addEventListener("click", () => {
              currentIndex = idx;
              updateSlider();
              resetAutoPlay();
            });
          });

          startAutoPlay();
        });
      </script>
    </header>

    <!-- Blog Feed Grid -->
    <div class="app-layout py-24">
      <div class="flex items-center gap-4 border-b border-border pb-4 mb-12">
        <h2 class="font-mono text-sm tracking-widest uppercase text-text-muted">Field Notes Archive</h2>
        <div class="h-px flex-1 bg-border"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentPosts.map((post, index) => (
          <a 
            href={`/posts/${post.id}`} 
            class="group flex flex-col gap-5 items-start no-underline" 
            style={`transition-delay: ${index * 50}ms`}
          >
            <!-- Image on Top -->
            <div class="w-full aspect-square border border-border bg-bg-secondary rounded-lg overflow-hidden relative shrink-0">
              <img src={post.data.ogImage || "/images/hero.png"} alt={post.data.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
            </div>
            
            <!-- Text Below -->
            <div class="w-full flex flex-col gap-3">
              <div class="flex items-center gap-3">
                <span class="font-mono text-[0.6rem] font-medium uppercase tracking-widest text-accent px-2 py-0.5 bg-accent/10 rounded-full">
                  {post.data.series ?? "Field Log"}
                </span>
              </div>
              <h4 class="text-xl font-semibold text-foreground group-hover:text-accent transition-colors leading-tight">
                {post.data.title}
              </h4>
              <p class="text-text-secondary leading-relaxed text-sm line-clamp-3">
                {post.data.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <section class="border-t border-border py-24 bg-bg-secondary relative overflow-hidden">
      <div class="app-layout max-w-2xl mx-auto text-center relative z-10 flex flex-col items-center">
        <h2 class="text-3xl font-semibold tracking-tight text-foreground mb-4">Subscribe to the Signal</h2>
        <p class="text-text-secondary mb-10">
          Get one field note when there is a real artifact worth studying. No hype. No spam.
        </p>
        <div class="w-full glass-panel p-2">
          <NewsletterSignup compact class="w-full" />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
