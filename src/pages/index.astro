---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.slice(0, SITE.postPerIndex);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
---

<Layout
  title="vibecode — field notes from a vibe coding castaway"
  description="I started vibe coding six months ago with zero programming background."
>
  <Header />

    <header class="hero-journal-wrap py-24 mb-16">
    <img src="/images/home/hero-journal.png" class="hero-journal-img" alt="" />
    <div class="app-layout relative z-10">
      <div class="flex items-center gap-4 mb-10 text-[0.8rem] tracking-[0.4em] font-mono text-ink-faded uppercase">
        <span>FIELD JOURNAL · NO. 04</span>
        <span class="h-px w-12 bg-accent"></span>
        <span>2026.05</span>
      </div>
      <h1 class="text-5xl md:text-8xl font-serif italic text-ink tracking-tighter leading-[0.95] mb-10 max-w-4xl">
        I started vibe coding <br/> six months ago.
      </h1>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-end">
        <p class="text-xl md:text-2xl text-text-secondary font-serif leading-relaxed italic">
          "The project hit 10,847 lines I couldn't explain. These are the field notes of a castaway finding order in the jungle."
        </p>
        <div class="flex flex-col items-start gap-4">
          <a href="/posts/" class="group flex items-center gap-4 font-mono text-xs tracking-[0.3em] uppercase bg-accent text-ink font-black px-6 py-4 hover:bg-accent transition-colors">
            Enter the Journal <span>&rarr;</span>
          </a>
          <a href="/about/" class="font-mono text-[0.65rem] tracking-[0.2em] uppercase text-ink-faded hover:text-ink underline underline-offset-4">
            About the Vibe Coding project
          </a>
        </div>
      </div>
    </div>
  </header>

  <main id="main-content" class="app-layout py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
      <!-- Left: Featured Content (The "Magazine" Lead) -->
      <div class="lg:col-span-8 space-y-16">
        {featuredPosts.length > 0 && (
          <section class="featured-lead">
            <div class="text-mono text-[0.7rem] tracking-[0.3em] text-accent-dim uppercase mb-6 font-bold">Featured Dispatch</div>
            <a href={`/posts/${featuredPosts[0].id}`} class="group block no-underline">
              <h2 class="text-4xl md:text-6xl font-serif italic mb-8 leading-[1.1] group-hover:underline decoration-accent/30 text-ink">
                {featuredPosts[0].data.title}
              </h2>
              <p class="text-xl md:text-2xl text-text-secondary font-serif leading-relaxed mb-10 max-w-2xl">
                {featuredPosts[0].data.description}
              </p>
              <span class="inline-block font-mono text-xs tracking-widest uppercase border-b-2 border-ink pb-1 group-hover:text-accent group-hover:border-accent transition-colors">
                Read full entry &rarr;
              </span>
            </a>
          </section>
        )}

        <hr class="border-ink/5" />

        <section class="other-featured pt-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            {featuredPosts.slice(1).map(post => (
              <a href={`/posts/${post.id}`} class="group block no-underline border border-ink/10 p-8 hover:bg-paper-warm transition-colors">
                <div class="text-mono text-[0.6rem] tracking-widest text-ink-faded uppercase mb-4">Featured</div>
                <h3 class="text-2xl font-serif italic mb-4 text-ink group-hover:underline decoration-accent/30">{post.data.title}</h3>
                <p class="text-base text-text-secondary font-serif leading-relaxed line-clamp-3">{post.data.description}</p>
              </a>
            ))}
          </div>
        </section>
      </div>

      <!-- Right: Sidebar Dispatches (Recent list) -->
      <aside class="lg:col-span-4 border-t lg:border-t-0 lg:border-l border-ink/10 pt-16 lg:pt-0 lg:pl-16">
        <h2 class="font-mono text-[0.7rem] tracking-[0.4em] uppercase text-ink-faded mb-10">Recent Logs</h2>
        <ul class="space-y-10">
          {recentPosts.map(post => (
            <li class="relative pl-0 group">
              <div class="font-mono text-[0.6rem] tracking-widest text-ink-faded uppercase mb-2">
                {new Date(post.data.pubDatetime).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </div>
              <a href={`/posts/${post.id}`} class="block no-underline">
                <h4 class="text-xl font-serif italic group-hover:text-accent-dim leading-tight text-ink">{post.data.title}</h4>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-20 pt-10 border-t-2 border-ink">
          <div class="text-[0.7rem] tracking-[0.3em] font-mono text-ink uppercase mb-6 font-bold">The Manifesto</div>
          <p class="text-lg font-serif italic leading-relaxed text-ink/80">
            "Not a tutorial. Not a success story. Not 10 tips from an AI expert. Just field notes from the jungle of AI-generated code."
          </p>
          <a href="/about" class="inline-block mt-8 text-[0.7rem] font-mono tracking-widest uppercase border-b border-ink/30 hover:border-ink transition-colors">Learn More</a>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;  
    overflow: hidden;
  }
  .masthead {
    background-color: var(--background);
  }
</style>