---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Scribble from "@/components/Scribble.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";

import Footer from "@/components/Footer.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import referenceCeiling from "@/data/reference-ceiling-scores.json";
import referenceBloggerCeiling from "@/data/reference-blogger-ceiling-scores.json";
import writingPulse from "@/data/writing-pulse-scores.json";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);
const evidencePosts = sortedPosts.filter(post => post.data.workflow === "packet" && post.data.references?.length);
const getReferenceCeiling = (slug: string) =>
  referenceCeiling.posts[slug as keyof typeof referenceCeiling.posts]?.score;
const getReferenceBloggerCeiling = (slug: string) =>
  referenceBloggerCeiling.posts[slug as keyof typeof referenceBloggerCeiling.posts]?.score;
const getWritingPulse = (slug: string) =>
  writingPulse.posts[slug as keyof typeof writingPulse.posts]?.score;
const getEvidenceStrength = (post: (typeof evidencePosts)[number]) => {
  const bloggerScore = getReferenceBloggerCeiling(post.id) ?? 0;
  const referenceScore = getReferenceCeiling(post.id) ?? 0;
  const pulseScore = getWritingPulse(post.id) ?? 0;
  const sourceScore = Math.min(post.data.references?.length ?? 0, 6) * 3;
  const featuredBonus = post.data.featured ? 2 : 0;
  return bloggerScore + referenceScore + pulseScore + sourceScore + featuredBonus;
};
const evidenceRankedPosts = [...evidencePosts].sort((a, b) => getEvidenceStrength(b) - getEvidenceStrength(a));
const featuredPosts = evidenceRankedPosts.slice(0, 1);
const leadPost = evidenceRankedPosts[0];
const recentPosts = evidenceRankedPosts.filter(post => post.id !== leadPost?.id).slice(0, SITE.postPerIndex);
const leadSourceCount = leadPost?.data.references?.length ?? 0;
const leadProofRows = leadPost
  ? [
      { label: "Artifact", value: "One DESIGN.md file with roles, token values, and the reasoning that keeps them connected." },
      { label: "Problem", value: "Agents can copy a look while losing the design decision that made the look work." },
      { label: "Rule", value: "Give the agent named roles, concrete tokens, and a way to reject bad contrast." },
      { label: "Sources", value: `${leadSourceCount} references behind the argument.` },
    ]
  : [];
const editorialPrinciples = [
  { label: "AEO Direct Answers First", value: "Every post starts with a 50-word TL;DR structured explicitly for AI engines to scrape and cite." },
  { label: "Plug-and-Play Artifacts", value: "We share complete, functioning code blocks, prompts, and config files. Copy them directly to your project." },
  { label: "Optimize for Solo Leverage", value: "Strategies focused purely on multiplying a single founder's output without hiring a team." },
];
---


<Layout
  title="vibecode | Field notes for agentic software"
  description="Field notes for people shipping software with agents: real artifacts, broken runs, design contracts, and operating rules."
>
  <Header />

  <main id="main-content" class="app-layout py-12">
    <!-- Horizontal Scroller: Latest & Featured -->
    <section class="mb-16 mt-8 reveal-on-scroll">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="text-2xl font-semibold tracking-tight text-foreground">Latest & Recommended</h2>
        <div class="h-px flex-1 bg-border"></div>
      </div>
      
      <div class="flex overflow-x-auto gap-6 pb-8 snap-x snap-mandatory scrollbar-hide">
        {sortedPosts.slice(0, 6).map(post => (
          <a href={`/posts/${post.id}`} class="snap-start shrink-0 w-80 group flex flex-col gap-4 no-underline bg-bg-secondary p-4 rounded-xl border border-border hover:border-accent transition-colors">
            {post.data.ogImage && (
              <div class="w-full aspect-square border border-border bg-background rounded-lg overflow-hidden relative">
                <img src={post.data.ogImage} alt={post.data.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              </div>
            )}
            <div>
              <div class="flex items-center gap-2 mb-2">
                <span class="font-mono text-[0.6rem] uppercase tracking-widest text-accent px-2 py-0.5 bg-accent/10 rounded-full">
                  {post.data.series ?? "Field Log"}
                </span>
                {post.data.featured && (
                  <span class="font-mono text-[0.6rem] uppercase tracking-widest text-background bg-foreground px-2 py-0.5 rounded-full">
                    Recommended
                  </span>
                )}
              </div>
              <h3 class="text-lg font-semibold text-foreground group-hover:text-accent transition-colors leading-tight line-clamp-2">
                {post.data.title}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Hero Landing -->
    <div class="mb-16 mt-8 flex justify-center reveal-on-scroll">
      <img src="/images/hero.png" alt="VibeCode Town - A retro-futuristic hacker town" class="w-full max-w-5xl rounded-xl border-4 border-foreground shadow-[8px_8px_0px_var(--foreground)] object-cover aspect-square" />
    </div>

    <!-- Blog Feed (Fly.io Style Layout) -->
    <div class="flex flex-col gap-16 mt-32">
      <div class="flex items-center gap-4 border-b border-border pb-4">
        <h2 class="font-mono text-xs tracking-widest uppercase text-text-muted">Field Notes</h2>
        <div class="h-px flex-1 bg-border"></div>
      </div>

      {leadPost ? (
        <a
          href={`/posts/${leadPost.id}`}
          class="group flex flex-col gap-8 reveal-on-scroll no-underline"
          data-article-card
        >
          {leadPost.data.ogImage && (
            <!-- Massive Top Image -->
            <div class="border border-border bg-bg-secondary relative aspect-square md:aspect-square overflow-hidden rounded-xl">
              <img src={leadPost.data.ogImage} alt={leadPost.data.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
            </div>
          )}
          <!-- Text Content below -->
          <div class="flex flex-col gap-4 max-w-4xl mx-auto text-center items-center">
            <div class="flex items-center justify-center gap-3">
              <span class="px-3 py-1 text-[0.65rem] font-bold uppercase tracking-widest text-background bg-foreground rounded-full">
                {leadPost.data.series ?? "Featured"}
              </span>
              <span class="font-mono text-[0.65rem] tracking-widest text-text-muted">
                {leadPost.data.references?.length ?? 0} References
              </span>
            </div>
            <h3 class="text-4xl md:text-5xl font-semibold tracking-tight text-foreground group-hover:text-accent transition-colors mt-2">
              {leadPost.data.title}
            </h3>
            <p class="text-xl text-text-secondary leading-relaxed mt-2">
              {leadPost.data.description}
            </p>
          </div>
        </a>
      ) : null}

      <!-- Recent Posts List (Grid) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12 pt-12 border-t border-border">
        {recentPosts.length > 0 ? (
          recentPosts.map((post, index) => (
            <a 
              href={`/posts/${post.id}`} 
              class="group flex flex-col gap-5 items-start no-underline reveal-on-scroll" 
              style={`transition-delay: ${index * 100}ms`}
            >
              {post.data.ogImage && (
                <!-- Image on Top -->
                <div class="w-full aspect-square border border-border bg-bg-secondary rounded-lg overflow-hidden relative shrink-0">
                  <img src={post.data.ogImage} alt={post.data.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                </div>
              )}
              
              <!-- Text Below -->
              <div class="w-full flex flex-col gap-3">
                <div class="flex items-center gap-3">
                  <span class="font-mono text-[0.6rem] font-medium uppercase tracking-widest text-accent">
                    {post.data.series ?? "Field Log"}
                  </span>
                  <span class="w-1 h-1 rounded-full bg-border"></span>
                  <span class="font-mono text-[0.6rem] tracking-widest text-text-muted">
                    {post.data.references?.length ?? 0} References
                  </span>
                </div>
                <h4 class="text-xl md:text-2xl font-semibold text-foreground group-hover:text-accent transition-colors leading-tight">
                  {post.data.title}
                </h4>
                <p class="text-text-secondary leading-relaxed text-base line-clamp-3">
                  {post.data.description}
                </p>
              </div>
            </a>
          ))
        ) : (
          <div class="col-span-full text-sm font-mono text-text-muted uppercase tracking-widest text-center py-12 border border-dashed border-border rounded-xl">Awaiting the next log...</div>
        )}
      </div>
    </div>
  </main>

  <section class="mt-24 border-t border-border py-24 bg-bg-secondary relative overflow-hidden reveal-on-scroll">
    <div class="app-layout max-w-2xl mx-auto text-center relative z-10 flex flex-col items-center">
      <h2 class="text-3xl font-semibold tracking-tight text-foreground mb-4">Subscribe to the Signal</h2>
      <p class="text-text-secondary mb-10">
        Get one field note when there is a real artifact worth studying. No hype. No spam.
      </p>
      <div class="w-full glass-panel p-2">
        <NewsletterSignup compact class="w-full" />
      </div>
    </div>
  </section>

  <Footer />
</Layout>
