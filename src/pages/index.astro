---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import Footer from "@/components/Footer.astro";
import getSortedPosts from "@/utils/getSortedPosts";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);
const sliderPosts = sortedPosts.slice(0, 5);
const recentPosts = sortedPosts;
---

<Layout
  title="vibecode | Field notes for agentic software"
  description="Field notes for people shipping software with agents: real artifacts, broken runs, design contracts, and operating rules."
>
  <Header />

  <main id="main-content">
    <!-- Massive Crossfading Hero Section (The Slider) -->
    <section class="relative min-h-[95vh] w-full overflow-hidden border-b border-border bg-background" id="hero-rotator">
      
      <!-- Slide 0: The Solopreneur Pitch -->
      <div class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-100 z-20" data-hero-slide="0">
        <!-- Background Video -->
        <div class="absolute inset-0">
          <video 
            autoPlay 
            loop 
            muted 
            playsInline 
            class="w-full h-full object-cover opacity-80"
            src="/hero-bg.mp4"
          ></video>
        </div>
        <!-- Gradient Overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-background via-background/50 to-transparent"></div>  

        <!-- Content -->
        <div class="app-layout relative z-10 h-full flex flex-col items-center justify-center text-center pt-20">
          <div class="inline-flex items-center gap-3 px-3 py-1 mb-8 text-[0.7rem] font-mono tracking-widest uppercase border rounded-full border-border bg-bg-secondary/50 text-text-secondary">
            <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
            The 1-Person Unicorn
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-tight mb-6 max-w-3xl drop-shadow-md">
            Scaling your solopreneur business with <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-accent-dim">autonomous agents</span>.
          </h1>
          
          <p class="text-lg md:text-xl text-text-secondary max-w-2xl leading-relaxed mb-10 drop-shadow-sm">
            Real artifacts, production workflows, and AEO-ready frameworks. 
            Copy our systems to build a 10-person business, alone.
          </p>

          <div class="flex gap-4">
            <a href="/about/" class="px-6 py-3 text-sm font-medium transition-colors border rounded-md text-background bg-foreground hover:bg-background hover:text-foreground hover:border-foreground backdrop-blur-sm">
              About the Project
            </a>
          </div>
        </div>
      </div>

      <!-- Slides 1-N: Latest Posts -->
      {sliderPosts.map((post, idx) => (
        <div class="absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0 z-10 pointer-events-none" data-hero-slide={idx + 1}>
          <!-- Background -->
          <div class="absolute inset-0">
            <img src={post.data.ogImage || "/images/hero-fallback.webp"} alt={post.data.title} class="w-full h-full object-cover opacity-70 mix-blend-luminosity" />
          </div>
          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-background via-background/60 to-transparent"></div>
          
          <!-- Content -->
          <div class="app-layout relative z-10 h-full flex flex-col items-center justify-center text-center pt-20">
            <div class="inline-flex items-center gap-3 px-3 py-1 mb-8 text-[0.7rem] font-mono tracking-widest uppercase border rounded-full border-border bg-bg-secondary/50 text-accent">
              <span class="w-2 h-2 rounded-full bg-accent"></span>
              {post.data.series ?? "Field Notes"}
            </div>
            
            <a href={`/posts/${post.id}`} class="block group no-underline">
              <h2 class="text-3xl md:text-5xl font-bold tracking-tight leading-snug mb-6 max-w-3xl group-hover:text-accent transition-colors drop-shadow-md">
                {post.data.title}
              </h2>
              
              <p class="text-base md:text-xl text-text-secondary max-w-2xl leading-relaxed mb-8 mx-auto line-clamp-3 drop-shadow-sm">
                {post.data.description}
              </p>
              
              <span class="px-6 py-3 text-sm font-medium transition-colors border rounded-md text-background bg-foreground group-hover:bg-background group-hover:text-foreground group-hover:border-foreground backdrop-blur-sm inline-block">
                Read Field Note
              </span>
            </a>
          </div>
        </div>
      ))}

      <!-- Controls & Progress -->
      <div class="absolute bottom-12 left-0 w-full z-30">
        <div class="app-layout flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="flex gap-3" id="hero-dots">
            <!-- Dot for Slide 0 -->
            <button class="w-12 h-1 bg-foreground transition-all duration-300 rounded-full" data-slide-dot="0" aria-label="Go to Pitch"></button>
            <!-- Dots for Posts -->
            {sliderPosts.map((_, idx) => (
              <button class="w-12 h-1 bg-border hover:bg-foreground/50 transition-all duration-300 rounded-full" data-slide-dot={idx + 1} aria-label={`Go to post ${idx + 1}`}></button>
            ))}
          </div>
          <div class="flex items-center gap-4">
            <button id="hero-prev" class="w-12 h-12 flex items-center justify-center rounded-full border border-border bg-bg-secondary/50 hover:bg-foreground hover:text-background transition-colors backdrop-blur-sm" aria-label="Previous">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button id="hero-next" class="w-12 h-12 flex items-center justify-center rounded-full border border-border bg-bg-secondary/50 hover:bg-foreground hover:text-background transition-colors backdrop-blur-sm" aria-label="Next">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const slides = document.querySelectorAll("[data-hero-slide]");
        const dots = document.querySelectorAll("[data-slide-dot]");
        const prevBtn = document.getElementById("hero-prev");
        const nextBtn = document.getElementById("hero-next");
        
        if (!slides.length) return;

        let currentIndex = 0;
        const totalSlides = slides.length;
        let interval;

        const updateHero = () => {
          slides.forEach((slide, idx) => {
            if (idx === currentIndex) {
              slide.classList.replace("opacity-0", "opacity-100");
              slide.classList.replace("z-10", "z-20");
              slide.classList.remove("pointer-events-none");
            } else {
              slide.classList.replace("opacity-100", "opacity-0");
              slide.classList.replace("z-20", "z-10");
              slide.classList.add("pointer-events-none");
            }
          });
          
          dots.forEach((dot, idx) => {
            if (idx === currentIndex) {
              dot.classList.replace("bg-border", "bg-foreground");
              dot.classList.remove("hover:bg-foreground/50");
            } else {
              dot.classList.replace("bg-foreground", "bg-border");
              dot.classList.add("hover:bg-foreground/50");
            }
          });
        };

        const nextSlide = () => {
          currentIndex = (currentIndex + 1) % totalSlides;
          updateHero();
        };

        const prevSlide = () => {
          currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
          updateHero();
        };

        const startAutoPlay = () => {
          interval = setInterval(nextSlide, 6000);
        };

        const resetAutoPlay = () => {
          clearInterval(interval);
          startAutoPlay();
        };

        if (nextBtn) nextBtn.addEventListener("click", () => { nextSlide(); resetAutoPlay(); });
        if (prevBtn) prevBtn.addEventListener("click", () => { prevSlide(); resetAutoPlay(); });

        dots.forEach((dot, idx) => {
          dot.addEventListener("click", () => {
            currentIndex = idx;
            updateHero();
            resetAutoPlay();
          });
        });

        startAutoPlay();
      });
    </script>

    <!-- Blog Feed Grid -->
    <div class="app-layout py-24">
      <div class="flex items-center gap-4 border-b border-border pb-4 mb-12">
        <h2 class="font-mono text-sm tracking-widest uppercase text-text-muted">Field Notes Archive</h2>
        <div class="h-px flex-1 bg-border"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentPosts.map((post, index) => (
          <a 
            href={`/posts/${post.id}`} 
            class="group flex flex-col gap-5 items-start no-underline" 
            style={`transition-delay: ${index * 50}ms`}
          >
            <!-- Image on Top -->
            <div class="w-full aspect-square border border-border bg-bg-secondary rounded-lg overflow-hidden relative shrink-0">
              <img src={post.data.ogImage || "/images/hero-fallback.webp"} alt={post.data.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
            </div>
            
            <!-- Text Below -->
            <div class="w-full flex flex-col gap-3">
              <div class="flex items-center gap-3">
                <span class="font-mono text-[0.6rem] font-medium uppercase tracking-widest text-accent px-2 py-0.5 bg-accent/10 rounded-full">
                  {post.data.series ?? "Field Log"}
                </span>
              </div>
              <h4 class="text-xl font-semibold text-foreground group-hover:text-accent transition-colors leading-tight">
                {post.data.title}
              </h4>
              <p class="text-text-secondary leading-relaxed text-sm line-clamp-3">
                {post.data.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <section class="border-t border-border py-24 relative overflow-hidden">
      <!-- Background Video -->
      <div class="absolute inset-0 z-0">
        <video 
          autoPlay 
          loop 
          muted 
          playsInline 
          class="w-full h-full object-cover opacity-50"
          src="/hero-bg.mp4"
        ></video>
        <div class="absolute inset-0 bg-gradient-to-t from-background via-background/80 to-background"></div>
      </div>

      <div class="app-layout max-w-2xl mx-auto text-center relative z-10 flex flex-col items-center">
        <h2 class="text-3xl font-semibold tracking-tight text-foreground mb-4 drop-shadow-md">Subscribe to the Signal</h2>
        <p class="text-text-secondary mb-10 drop-shadow-sm">
          Get one field note when there is a real artifact worth studying. No hype. No spam.
        </p>
        <div class="w-full backdrop-blur-md bg-background/50 border border-border rounded-xl p-6 shadow-[0_0_30px_rgba(0,229,153,0.1)]">
          <NewsletterSignup compact class="w-full" />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
