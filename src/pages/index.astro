---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Scribble from "@/components/Scribble.astro";
import VibeExplorer from "@/components/VibeExplorer.astro";
import Footer from "@/components/Footer.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.slice(0, SITE.postPerIndex);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
---

<Layout
  title="vibecode — field notes from a vibe coding castaway"
  description="I started vibe coding six months ago with zero programming background."
>
  <Header />

  <header class="hero-journal-wrap py-24 mb-16 relative overflow-hidden">
    <img src="/images/home/hero-journal.png" class="hero-journal-img opacity-20" alt="" />
    
    <div class="app-layout relative z-10">
      <!-- Interactive Demo Section -->
      <div id="demo-simulator" class="mb-12 p-6 bg-ink/5 border border-ink/10 rounded-xl backdrop-blur-md max-w-xl">
        <div class="flex items-center justify-between mb-4">
          <div class="flex gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500/50"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/50"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/50"></span>
          </div>
          <div class="text-[10px] font-mono text-ink/40 uppercase tracking-widest">Live Agent Simulator</div>
        </div>
        <div id="simulator-output" class="font-mono text-sm text-ink/80 min-h-[80px] leading-relaxed">
          > System initialized. Awaiting vibe...
        </div>
        <button id="run-demo-btn" class="mt-4 px-4 py-2 bg-accent text-ink text-[10px] font-black uppercase tracking-tighter hover:scale-105 transition-transform">
          Trigger Agent Pulse
        </button>
      </div>

      <div class="flex items-center gap-4 mb-10 text-[0.8rem] tracking-[0.4em] font-mono text-ink-faded uppercase">
        <span>FIELD JOURNAL · NO. 04</span>
        <span class="h-px w-12 bg-accent"></span>
        <span>2026.05</span>
      </div>
      <h1 class="text-5xl md:text-8xl font-serif italic text-ink tracking-tighter leading-[0.95] mb-10 max-w-4xl">
        I started <Scribble type="underline">vibe coding</Scribble> <br/> six months ago.
      </h1>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-end">
        <p class="text-xl md:text-2xl text-text-secondary font-serif leading-relaxed italic">
          "The project hit 10,847 lines I couldn't explain. These are the field notes of a castaway finding order in the jungle."
        </p>
        <div class="flex flex-col items-start gap-4">
          <a href="/posts/" class="group flex items-center gap-4 font-mono text-xs tracking-[0.3em] uppercase bg-accent text-ink px-6 py-4 hover:bg-accent-dim transition-colors font-black">
            Enter the Journal <span>&rarr;</span>
          </a>
          <a href="/about/" class="font-mono text-[0.65rem] tracking-[0.2em] uppercase text-ink-faded hover:text-ink underline underline-offset-4">
            About the Vibe Coding project
          </a>
        </div>
      </div>
    </div>
  </header>

  <main id="main-content" class="app-layout py-12">
    <!-- Existing Content (Featured & Recent) -->
    <VibeExplorer />
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
      <div class="lg:col-span-8 space-y-16">
        {featuredPosts.length > 0 && (
          <section class="featured-lead">
            <div class="text-mono text-[0.7rem] tracking-[0.3em] text-accent-dim uppercase mb-6 font-bold">Featured Dispatch</div>
            <a href={`/posts/${featuredPosts[0].id}`} class="group block no-underline">
              <h2 class="text-4xl md:text-6xl font-serif italic mb-8 leading-[1.1] group-hover:underline decoration-accent/30 text-ink">
                {featuredPosts[0].data.title}
              </h2>
              <p class="text-xl md:text-2xl text-text-secondary font-serif leading-relaxed mb-10 max-w-2xl">
                {featuredPosts[0].data.description}
              </p>
            </a>
          </section>
        )}
      </div>

      <aside class="lg:col-span-4 border-t lg:border-t-0 lg:border-l border-ink/10 pt-16 lg:pt-0 lg:pl-16">
        <h2 class="font-mono text-[0.7rem] tracking-[0.4em] uppercase text-ink-faded mb-10">Recent Logs</h2>
        <ul class="space-y-10">
          {recentPosts.map(post => (
            <li class="relative pl-0 group">
              <a href={`/posts/${post.id}`} class="block no-underline">
                <h4 class="text-xl font-serif italic group-hover:text-accent-dim leading-tight text-ink">{post.data.title}</h4>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </main>

  
    <!-- Newsletter Signup -->
    <section class="mt-24 border-y border-ink/10 py-16 bg-accent/5">
      <div class="app-layout max-w-2xl mx-auto text-center">
        <h2 class="text-3xl font-serif italic mb-4 text-ink">Get notified on launch</h2>
        <p class="text-text-secondary font-serif italic mb-8">
          The journal is just the beginning. I'm building tools to help us all vibe better.
          Enter your email to join the inner circle.
        </p>
        <form class="flex flex-col sm:flex-row gap-4">
          <input 
            type="email" 
            placeholder="your@email.com" 
            class="flex-1 px-6 py-4 bg-background border border-ink/20 font-serif italic focus:outline-none focus:border-accent"
            required
          />
          <button 
            type="submit" 
            class="bg-ink text-background px-8 py-4 font-mono text-xs tracking-[0.3em] uppercase font-black hover:bg-ink/90 transition-colors"
          >
            Join the Vibe
          </button>
        </form>
        <p class="mt-4 text-[10px] font-mono text-ink-faded uppercase tracking-widest">No spam. Only deep vibes.</p>
      </div>
    </section>

  <Footer />

  <script is:inline>
    const btn = document.querySelector('#run-demo-btn');
    const output = document.querySelector('#simulator-output');
    const logs = [
      "> Scanning workspace components...",
      "> Identified 12 architectural debt points.",
      "> Drafting surgical implementation plan...",
      "> Executing vibe-coding pulse...",
      "> SUCCESS: VMG Intelligence Layer deployed."
    ];

    if (btn && output) {
      btn.addEventListener('click', () => {
        let i = 0;
        output.innerHTML = "";
        btn.disabled = true;
        btn.innerText = "Simulating...";
        
        const timer = setInterval(() => {
          if (i < logs.length) {
            output.innerHTML += `<div>${logs[i]}</div>`;
            i++;
          } else {
            clearInterval(timer);
            btn.disabled = false;
            btn.innerText = "Pulse Complete";
            setTimeout(() => { btn.innerText = "Trigger Agent Pulse"; }, 3000);
          }
        }, 800);
      });
    }
  </script>
</Layout>
