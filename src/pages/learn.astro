---
// /learn — The Agentic Software Workshop (S-grade course funnel).
// vibecode 의 강의형 승급: 블로그(무료 권위/AEO 깔때기) → 워크샵(전환).
// 커리큘럼은 실제 발행된 Field Notes 글에 1:1 그라운딩 — 발명 아님, 살아있는 교재.
// 결제 미연동 + 대외 가격 약속 리스크 → buy 버튼 대신 "Founding Cohort 대기자(뉴스레터 캡처)".
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";

// 권위 증명: 실제 발행 글 수 = 살아있는 교재 규모.
const posts = await getCollection("blog", ({ data }) => !data.draft);
const noteCount = posts.length;

// 커리큘럼 — 각 모듈은 실제 Field Note 글에 그라운딩(slug 존재 시 링크).
const MODULES = [
  { n: "01", title: "The 1-Person Unicorn Stack", desc: "10명 몫을 혼자 굴리는 에이전트 스택 전체 구성도 — 무엇을 자동화하고 무엇을 손에 쥐는가.", slug: "1-person-unicorn-tech-stack-2026" },
  { n: "02", title: "Design as a Technical Contract", desc: "디자인을 토큰·스펙으로 박아 에이전트가 어긋나지 않게 만드는 계약 설계.", slug: "design-is-a-technical-contract" },
  { n: "03", title: "Agent Memory, Structured", desc: "세션을 넘어 누적되는 운영 기억 — 무엇을 저장하고 무엇을 버리는가.", slug: "ai-memory-operating-structure" },
  { n: "04", title: "The Disk Contract for Agent Work", desc: "에이전트가 파일시스템을 안전하게 쓰게 하는 경계·규약. 제품↔데이터 분리의 실전.", slug: "ai-agent-work-disk-contract" },
  { n: "05", title: "MCP Shared State & Data Boundaries", desc: "여러 에이전트가 같은 상태를 만질 때의 데이터 누수 — 실제 사고와 차단 패턴.", slug: "mcp-shared-state-data-leak" },
  { n: "06", title: "Evals: Self-Improving Agents", desc: "측정 없이는 못 키운다 — 자기개선 루프를 만드는 평가 하네스.", slug: "self-improving-agents-need-evals" },
  { n: "07", title: "Frustration as Spec", desc: "막힌 지점을 그대로 명세로 바꾸는 법 — 반복 교정을 자산으로.", slug: "frustration-as-spec" },
  { n: "08", title: "Review Artifacts for Agents", desc: "에이전트 산출물을 사람이 5분 안에 검수하게 만드는 HTML 리뷰 아티팩트.", slug: "html-review-artifacts-for-agents" },
];

const PILLARS = [
  { k: "Evidence, not hype", v: "마법 서사 없음. 실제 run.log·코드·아티팩트로만 가르친다." },
  { k: "Live curriculum", v: `${noteCount}편의 Field Notes가 그대로 교재 — 운영하며 계속 갱신된다.` },
  { k: "Copy the systems", v: "이론이 아니라 그대로 복제해 쓰는 운영 시스템(스택·계약·하네스)." },
];

const FAQS = [
  { q: "누구를 위한 워크샵인가?", a: "에이전트로 실제 제품·회사를 굴리려는 시니어 엔지니어/솔로프리너. 프롬프트 팁이 아니라 운영 시스템을 원하는 사람." },
  { q: "블로그 글과 뭐가 다른가?", a: "Field Notes는 무료로 공개된 단편이다. 워크샵은 그 조각들을 하나의 작동하는 운영체계로 엮고, 실제 코드·하네스·체크리스트를 순서대로 따라 구축한다." },
  { q: "선행 지식이 필요한가?", a: "프로덕션 코드를 짜본 엔지니어 기준. 특정 언어보다 '시스템을 계약으로 사고하는' 자세가 중요하다." },
  { q: "가격과 일정은?", a: "Founding Cohort 정원·가격은 대기자에게 먼저, 공개 전 별도 안내한다. 지금은 자리를 잡아두는 단계." },
];
---

<Layout
  title="Workshop | vibecode — Build a 10-person company, alone"
  description="The agentic software workshop. Copy the operating systems behind a 1-person company: stack, design contracts, agent memory, evals, and review artifacts. Grounded in real run logs, not hype."
>
  <Header />

  <main id="main-content" class="app-layout">
    <!-- HERO -->
    <section class="border-b border-border py-16 sm:py-24">
      <div class="inline-flex items-center gap-3 px-3 py-1 mb-8 text-[0.7rem] font-mono tracking-widest uppercase border rounded-full border-border bg-bg-secondary text-accent">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        The Agentic Software Workshop
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.05] max-w-4xl">
        Build a 10-person company,
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-accent-dim">alone.</span>
      </h1>

      <p class="mt-6 text-lg sm:text-xl text-text-secondary max-w-2xl leading-relaxed">
        프롬프트 팁이 아니다. 에이전트로 실제 제품을 굴리는 <strong class="text-foreground">운영 시스템</strong>을
        그대로 복제한다 — 스택, 디자인 계약, 에이전트 기억, 평가 하네스, 리뷰 아티팩트.
        모든 수업은 실제 run.log와 코드에서 나온다.
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a href="#join" class="s-btn-primary">Join the Founding Cohort →</a>
        <a href="/posts" class="s-btn-ghost">Read the free Field Notes</a>
      </div>

      <!-- proof strip -->
      <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-px bg-border border border-border rounded-md overflow-hidden">
        <div class="bg-background p-4">
          <div class="font-mono text-2xl font-bold text-accent">{noteCount}</div>
          <div class="text-xs text-text-muted mt-1 uppercase tracking-wider">Live field notes</div>
        </div>
        <div class="bg-background p-4">
          <div class="font-mono text-2xl font-bold text-accent">8</div>
          <div class="text-xs text-text-muted mt-1 uppercase tracking-wider">Workshop modules</div>
        </div>
        <div class="bg-background p-4">
          <div class="font-mono text-2xl font-bold text-accent">100%</div>
          <div class="text-xs text-text-muted mt-1 uppercase tracking-wider">From real runs</div>
        </div>
        <div class="bg-background p-4">
          <div class="font-mono text-2xl font-bold text-accent">0</div>
          <div class="text-xs text-text-muted mt-1 uppercase tracking-wider">Magic wands</div>
        </div>
      </div>
    </section>

    <!-- PILLARS -->
    <section class="py-16 border-b border-border">
      <h2 class="font-mono text-sm uppercase tracking-widest text-text-muted mb-8">Why this workshop</h2>
      <div class="grid gap-6 sm:grid-cols-3">
        {PILLARS.map((p) => (
          <div class="s-card p-6">
            <h3 class="text-lg font-bold text-foreground">{p.k}</h3>
            <p class="mt-2 text-text-secondary leading-relaxed">{p.v}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CURRICULUM -->
    <section class="py-16 border-b border-border">
      <div class="flex items-end justify-between flex-wrap gap-4 mb-8">
        <h2 class="text-3xl font-bold tracking-tight">The curriculum</h2>
        <p class="text-sm text-text-muted max-w-md">
          각 모듈은 이미 공개된 Field Note에서 출발한다. 무료로 먼저 읽고, 워크샵에서 작동하는 하나의 체계로 엮는다.
        </p>
      </div>

      <div class="grid gap-px bg-border border border-border rounded-md overflow-hidden">
        {MODULES.map((m) => (
          <a href={`/posts/${m.slug}`} class="group bg-background p-6 flex gap-5 items-start no-underline hover:bg-bg-secondary transition-colors">
            <span class="font-mono text-sm font-bold text-accent shrink-0 pt-1">{m.n}</span>
            <div>
              <h3 class="text-lg font-bold text-foreground group-hover:text-accent transition-colors">{m.title}</h3>
              <p class="mt-1 text-text-secondary leading-relaxed">{m.desc}</p>
              <span class="mt-2 inline-block text-xs font-mono text-text-muted group-hover:text-accent">read the field note →</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- FUNNEL: free → workshop -->
    <section class="py-16 border-b border-border">
      <div class="s-card p-8 sm:p-10">
        <h2 class="text-2xl font-bold tracking-tight">From free notes to a working system</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-3 text-sm">
          <div>
            <div class="font-mono text-accent">01 — Read</div>
            <p class="mt-2 text-text-secondary leading-relaxed">무료 Field Notes로 사고방식과 증거를 먼저 흡수한다.</p>
          </div>
          <div>
            <div class="font-mono text-accent">02 — Build</div>
            <p class="mt-2 text-text-secondary leading-relaxed">워크샵에서 스택·계약·기억·평가를 순서대로 직접 구축한다.</p>
          </div>
          <div>
            <div class="font-mono text-accent">03 — Operate</div>
            <p class="mt-2 text-text-secondary leading-relaxed">혼자서 10명 몫을 굴리는 운영체계를 손에 쥔다.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- PRICING / FOUNDING COHORT -->
    <section id="join" class="py-16 border-b border-border">
      <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr] items-start">
        <div class="s-card p-8">
          <div class="font-mono text-xs uppercase tracking-widest text-accent">Founding Cohort</div>
          <h2 class="mt-3 text-3xl font-bold tracking-tight">Save your seat first.</h2>
          <p class="mt-4 text-text-secondary leading-relaxed">
            첫 코호트는 인원을 좁게 연다. 정원·일정·파운딩 가격은
            <strong class="text-foreground">대기자에게 가장 먼저</strong> 공개 전 안내한다.
            지금은 자리를 잡아두는 단계 — 비용도, 약속도 없다.
          </p>
          <ul class="mt-6 space-y-2 text-sm text-text-secondary">
            <li class="flex gap-2"><span class="text-accent">✓</span> 8개 모듈 전체 + 실제 코드·하네스·체크리스트</li>
            <li class="flex gap-2"><span class="text-accent">✓</span> 운영하며 갱신되는 살아있는 교재 (lifetime updates)</li>
            <li class="flex gap-2"><span class="text-accent">✓</span> 파운딩 코호트 한정 가격</li>
          </ul>
        </div>

        <div class="s-card p-8 bg-bg-secondary">
          <h3 class="text-lg font-bold text-foreground">Join the waitlist</h3>
          <p class="mt-1 text-sm text-text-secondary leading-relaxed">
            워크샵이 열릴 때 가장 먼저 알림을 받는다. 같은 채널로 Field Notes도 온다. 스팸 없음.
          </p>
          <NewsletterSignup class="mt-5" compact={true} />
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16">
      <h2 class="text-3xl font-bold tracking-tight mb-8">FAQ</h2>
      <div class="space-y-4 max-w-3xl">
        {FAQS.map((f) => (
          <details class="s-card p-5 group">
            <summary class="cursor-pointer font-semibold text-foreground list-none flex justify-between items-center">
              {f.q}
              <span class="text-accent font-mono group-open:rotate-45 transition-transform">+</span>
            </summary>
            <p class="mt-3 text-text-secondary leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* 브랜드 브루탈리즘 — 기존 global.css 패턴(2px border + offset shadow) 확장. */
  .s-card {
    border: 2px solid var(--foreground);
    box-shadow: 4px 4px 0 var(--foreground);
    border-radius: 0.375rem;
    background: var(--background);
  }
  .s-btn-primary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    font-weight: 600;
    border: 2px solid var(--foreground);
    background: var(--accent);
    color: var(--background);
    border-radius: 0.375rem;
    box-shadow: 3px 3px 0 var(--foreground);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
    text-decoration: none;
  }
  .s-btn-primary:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--foreground);
  }
  .s-btn-ghost {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    font-weight: 600;
    border: 2px solid var(--foreground);
    background: var(--background);
    color: var(--foreground);
    border-radius: 0.375rem;
    box-shadow: 2px 2px 0 var(--foreground);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
    text-decoration: none;
  }
  .s-btn-ghost:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--foreground);
  }
</style>
