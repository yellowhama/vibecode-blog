---
// /trends — Developer Search & Tech Trends Board
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const TRENDS = [
  {
    keyword: "Model Context Protocol (MCP)",
    trendScore: 98,
    geoPriority: "High (AEO)",
    status: "HOT",
    searchGrowth: "+142%",
    description: "Designing data boundaries and custom MCP shared states for agents interacting with external data safely.",
    lessonLink: "/posts/mcp-shared-state-data-leak",
    category: "Infrastructure"
  },
  {
    keyword: "Agentic Disk Contract",
    trendScore: 89,
    geoPriority: "High",
    status: "HOT",
    searchGrowth: "+85%",
    description: "Establishing strict safety protocols and boundaries to prevent physical damage to the local file system by agents.",
    lessonLink: "/posts/ai-agent-work-disk-contract",
    category: "Security"
  },
  {
    keyword: "Structured Agent Memory",
    trendScore: 85,
    geoPriority: "Medium",
    status: "EMERGING",
    searchGrowth: "+61%",
    description: "Cross-session persistent databases and in-memory session management architectures for autonomous agents.",
    lessonLink: "/posts/ai-memory-operating-structure",
    category: "Memory"
  },
  {
    keyword: "Technical UI Contracts",
    trendScore: 81,
    geoPriority: "Evergreen",
    status: "EVERGREEN",
    searchGrowth: "+30%",
    description: "Hardcoding design specs into tokens to eliminate UI/UX code generation drift in agent outputs.",
    lessonLink: "/posts/design-is-a-technical-contract",
    category: "Design"
  },
  {
    keyword: "Agent Self-Improving Evals",
    trendScore: 78,
    geoPriority: "High (AEO)",
    status: "EMERGING",
    searchGrowth: "+95%",
    description: "Building automated feedback loops that evaluate and improve agent tasks without manual human inspection.",
    lessonLink: "/posts/self-improving-agents-need-evals",
    category: "Evals"
  },
  {
    keyword: "HTML Review Artifacts",
    trendScore: 72,
    geoPriority: "Evergreen",
    status: "EVERGREEN",
    searchGrowth: "+24%",
    description: "Designing sandbox render artifacts that allow human operators to verify agent UI outputs in under 30 seconds.",
    lessonLink: "/posts/html-review-artifacts-for-agents",
    category: "UX"
  }
];

const METRICS = {
  totalQueries: "14.2K",
  geoCoverage: "88.4%",
  updatedAt: "2026-06-10"
};
---

<Layout
  title="Developer Trends | vibecode"
  description="Agentic software engineering trend board. Track high-growth keywords, AI Search engine (GEO) priority, and real search demand matched to live lessons."
>
  <Header />

  <main id="main-content" class="app-layout">
    <!-- HERO -->
    <section class="border-b border-border py-12 sm:py-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-6 text-[0.7rem] font-mono tracking-widest uppercase border rounded-full border-border bg-bg-secondary text-accent">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        Demand & Search Trends (Live)
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-[1.1] max-w-3xl">
        Engineering Demands <br class="max-sm:hidden"/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-accent-dim">Identified by AI Agents</span>
      </h1>

      <p class="mt-4 text-text-secondary max-w-2xl leading-relaxed">
        We normalize and track the most demanded real-world agent architecture keywords from search indexes and AI Chatbots (AEO) in real-time. Acquire high-demand skills early to build your 1-person unicorn stack.
      </p>

      <!-- statistics grid -->
      <div class="mt-8 grid grid-cols-3 gap-px bg-border border border-border rounded-md overflow-hidden">
        <div class="bg-background p-4 text-center">
          <div class="font-mono text-xl sm:text-2xl font-bold text-accent">{METRICS.totalQueries}</div>
          <div class="text-[0.65rem] sm:text-xs text-text-muted mt-1 uppercase tracking-wider">Dev Queries / Mo</div>
        </div>
        <div class="bg-background p-4 text-center">
          <div class="font-mono text-xl sm:text-2xl font-bold text-accent">{METRICS.geoCoverage}</div>
          <div class="text-[0.65rem] sm:text-xs text-text-muted mt-1 uppercase tracking-wider">AI Search Index</div>
        </div>
        <div class="bg-background p-4 text-center">
          <div class="font-mono text-xl sm:text-2xl font-bold text-accent">{METRICS.updatedAt}</div>
          <div class="text-[0.65rem] sm:text-xs text-text-muted mt-1 uppercase tracking-wider">Last Sync</div>
        </div>
      </div>
    </section>

    <!-- TREND BOARD LIST -->
    <section class="py-12">
      <div class="flex items-end justify-between flex-wrap gap-4 mb-8">
        <h2 class="text-2xl font-bold tracking-tight">Trending Keywords & Match</h2>
        <p class="text-xs text-text-muted max-w-xs">
          The trend score is a normalized value combining raw search volume and GEO citation priority.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        {TRENDS.map((t) => (
          <div class="s-card p-6 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="px-2 py-0.5 text-[0.65rem] font-mono border rounded bg-bg-secondary text-text-secondary">{t.category}</span>
                <span class:list={[
                  "font-mono text-[0.65rem] px-2 py-0.5 rounded font-bold border",
                  t.status === "HOT" ? "bg-rose-500/10 border-rose-500/30 text-rose-500" :
                  t.status === "EMERGING" ? "bg-amber-500/10 border-amber-500/30 text-amber-500" :
                  "bg-emerald-500/10 border-emerald-500/30 text-emerald-500"
                ]}>
                  {t.status}
                </span>
              </div>

              <h3 class="text-xl font-bold text-foreground mt-4">{t.keyword}</h3>
              <p class="mt-2 text-sm text-text-secondary leading-relaxed">{t.description}</p>
            </div>

            <div class="mt-6 pt-4 border-t border-dashed border-border flex items-center justify-between text-xs">
              <div class="flex gap-4">
                <div>
                  <span class="text-text-muted">Trend</span>
                  <strong class="font-mono text-accent block">{t.trendScore} ({t.searchGrowth})</strong>
                </div>
                <div>
                  <span class="text-text-muted">AEO Priority</span>
                  <strong class="font-mono text-foreground block">{t.geoPriority}</strong>
                </div>
              </div>

              <a href={t.lessonLink} class="font-mono text-accent hover:underline shrink-0">
                Study Lesson →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CALL TO ACTION (FOUNDING COHORT) -->
    <section class="py-12 border-t border-border">
      <div class="s-card p-8 bg-bg-secondary text-center max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold tracking-tight">Build the high-demand stack as a Solopreneur</h2>
        <p class="mt-3 text-sm text-text-secondary leading-relaxed max-w-xl mx-auto">
          Every core agentic architecture captured on this trend board is taught with production-ready code in our Agentic Software Workshop. Join the Founding Cohort and become an early adopter of the tech transition.
        </p>
        <div class="mt-6 flex justify-center gap-4">
          <a href="/learn" class="s-btn-primary text-sm">Join the waitlist</a>
          <a href="/posts" class="s-btn-ghost text-sm">Read Field Notes</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .s-card {
    border: 2px solid var(--foreground);
    box-shadow: 4px 4px 0 var(--foreground);
    border-radius: 0.375rem;
    background: var(--background);
  }
  .s-btn-primary {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    font-weight: 600;
    border: 2px solid var(--foreground);
    background: var(--accent);
    color: var(--background);
    border-radius: 0.375rem;
    box-shadow: 2px 2px 0 var(--foreground);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
    text-decoration: none;
  }
  .s-btn-primary:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--foreground);
  }
  .s-btn-ghost {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    font-weight: 600;
    border: 2px solid var(--foreground);
    background: var(--background);
    color: var(--foreground);
    border-radius: 0.375rem;
    box-shadow: 1.5px 1.5px 0 var(--foreground);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
    text-decoration: none;
  }
  .s-btn-ghost:hover {
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 var(--foreground);
  }
</style>
