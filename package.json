{
  "name": "astro-paper",
  "type": "module",
  "version": "5.5.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/copy-pagefind.mjs",
    "verify:site-quality": "npm run lint && npm run verify:content && npm run build && npm run verify:dist && npm run test:warden-field-log-gate",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:content": "npm run verify:editorial-contract && npm run verify:content-portfolio && npm run verify:musu-routing",
    "verify:editorial-contract": "node scripts/verify-editorial-contract.mjs",
    "verify:content-portfolio": "node scripts/verify-content-portfolio.mjs",
    "verify:musu-routing": "node scripts/verify-musu-routing.mjs",
    "verify:warden-field-log": "node scripts/verify-warden-field-log-ready.mjs",
    "incident:warden": "node scripts/create-warden-incident.mjs",
    "capture:warden-runtime": "node scripts/capture-warden-runtime-evidence.mjs",
    "diagnose:warden-runtime": "node scripts/diagnose-warden-runtime-capture.mjs",
    "init:warden-runtime-env": "node scripts/init-warden-runtime-env.mjs",
    "test:warden-field-log-gate": "node scripts/test-warden-field-log-gate.mjs",
    "test:warden-runtime-diagnose": "node scripts/test-warden-runtime-diagnose.mjs",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^6.3.3",
    "dayjs": "^1.11.19",
    "lodash.kebabcase": "^4.1.1",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.18.3",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@pagefind/default-ui": "^1.4.0",
    "@shikijs/transformers": "^3.20.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "globals": "^16.5.0",
    "pagefind": "^1.4.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  }
}
