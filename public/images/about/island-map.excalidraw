{
  "type": "excalidraw",
  "version": 2,
  "source": "vibecode.town",
  "elements": [
    {"id": "title", "type": "text", "x": 180, "y": 10, "width": 250, "height": 35, "text": "The Island", "fontSize": 28, "fontFamily": 4, "strokeColor": "#2D1D19", "textAlign": "center"},

    {"id": "island-shape", "type": "ellipse", "x": 80, "y": 60, "width": 500, "height": 300, "strokeColor": "#2D1D19", "backgroundColor": "#FDFCF0", "fillStyle": "solid", "roughness": 2, "strokeWidth": 2},

    {"id": "camp", "type": "rectangle", "x": 250, "y": 160, "width": 120, "height": 60, "strokeColor": "#2D1D19", "backgroundColor": "#FFD166", "fillStyle": "hachure", "roughness": 1, "strokeWidth": 2},
    {"id": "camp-text", "type": "text", "x": 270, "y": 175, "width": 80, "height": 30, "text": "🏕️ Camp\n(you are here)", "fontSize": 12, "fontFamily": 4, "strokeColor": "#2D1D19", "textAlign": "center"},

    {"id": "warehouse", "type": "rectangle", "x": 140, "y": 100, "width": 90, "height": 50, "strokeColor": "#2D1D19", "backgroundColor": "#FFD166", "fillStyle": "hachure", "roughness": 1, "strokeWidth": 2},
    {"id": "warehouse-text", "type": "text", "x": 148, "y": 115, "width": 75, "height": 20, "text": "📦 Wiki", "fontSize": 12, "fontFamily": 4, "strokeColor": "#2D1D19", "textAlign": "center"},

    {"id": "scout", "type": "rectangle", "x": 420, "y": 110, "width": 90, "height": 45, "strokeColor": "#2D1D19", "backgroundColor": "#FFD166", "fillStyle": "hachure", "roughness": 1, "strokeWidth": 2},
    {"id": "scout-text", "type": "text", "x": 428, "y": 122, "width": 75, "height": 20, "text": "🔭 Scout", "fontSize": 12, "fontFamily": 4, "strokeColor": "#2D1D19", "textAlign": "center"},

    {"id": "tools", "type": "rectangle", "x": 160, "y": 250, "width": 90, "height": 45, "strokeColor": "#2D1D19", "backgroundColor": "#FFD166", "fillStyle": "hachure", "roughness": 1, "strokeWidth": 2},
    {"id": "tools-text", "type": "text", "x": 168, "y": 262, "width": 75, "height": 20, "text": "🔧 Tools", "fontSize": 12, "fontFamily": 4, "strokeColor": "#2D1D19", "textAlign": "center"},

    {"id": "beach", "type": "rectangle", "x": 400, "y": 260, "width": 100, "height": 45, "strokeColor": "#2D1D19", "backgroundColor": "#FDFCF0", "fillStyle": "solid", "roughness": 1, "strokeWidth": 1, "strokeStyle": "dashed"},
    {"id": "beach-text", "type": "text", "x": 408, "y": 272, "width": 85, "height": 20, "text": "🌊 Web", "fontSize": 12, "fontFamily": 4, "strokeColor": "#2D1D19", "textAlign": "center"},

    {"id": "unexplored", "type": "text", "x": 350, "y": 330, "width": 160, "height": 20, "text": "~ unexplored ~", "fontSize": 12, "fontFamily": 4, "strokeColor": "#2D1D19", "textAlign": "center"},

    {"id": "path1", "type": "line", "x": 230, "y": 130, "width": 30, "height": 35, "strokeColor": "#2D1D19", "strokeWidth": 1, "roughness": 1, "strokeStyle": "dotted", "points": [[0,0],[30,35]]},
    {"id": "path2", "type": "line", "x": 370, "y": 185, "width": 55, "height": -55, "strokeColor": "#2D1D19", "strokeWidth": 1, "roughness": 1, "strokeStyle": "dotted", "points": [[0,0],[55,-55]]},
    {"id": "path3", "type": "line", "x": 250, "y": 220, "width": -50, "height": 35, "strokeColor": "#2D1D19", "strokeWidth": 1, "roughness": 1, "strokeStyle": "dotted", "points": [[0,0],[-50,35]]},
    {"id": "path4", "type": "line", "x": 500, "y": 155, "width": 10, "height": 110, "strokeColor": "#2D1D19", "strokeWidth": 1, "roughness": 1, "strokeStyle": "dotted", "points": [[0,0],[10,110]]}
