    "end_sec": 23.552,
    "duration_sec": 5.328,
    "path": "/mnt/e/vibecode-blog/systems/video/preproduction/act1-en_20260310_092949/audio_segments/N005.wav"
  },
  {
    "beat_id": "N006",
    "text": "It looked convincing. That's why it was dangerous. I was vibe coding with no map.",
