    "duration_sec": 5.784,
    "path": "/mnt/e/vibecode-blog/systems/video/preproduction/act1-en_20260310_092949/audio_segments/N003.wav"
  },
  {
    "beat_id": "N004",
    "text": "AI wrote a back door. I approved it. I didn't even know it was there.",
