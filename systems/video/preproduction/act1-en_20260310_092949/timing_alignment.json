    "end_sec": 18.024,
    "duration_sec": 4.176,
    "path": "/mnt/e/vibecode-blog/systems/video/preproduction/act1-en_20260310_092949/audio_segments/N004.wav"
  },
  {
    "beat_id": "N005",
    "text": "Five agents building the same thing. Three date formatters. Four ways to validate a string.",
