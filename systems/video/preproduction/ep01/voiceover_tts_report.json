    {
      "order": 31,
      "beat_id": "SEG04_B031",
      "scene_id": "SEG04",
      "text": "In February twenty twenty-five, Andrej Karpathy — one of the founders of Open A I — gave this a name. Vibe coding. Quote: \"You just talk in natural language, run it, and most of the time it just works.\"...",
      "expected_duration_sec": 14.8,
      "actual_duration_sec": 11.12,
      "backend": "chatterbox",
