{
  "_meta": {
    "title": "Vibecode Town - Flux Kontext 2D Edit (Golden Reference -> Scene) [GGUF]",
    "description": "Flux Kontext image-to-image workflow using GGUF quantized models for editing a golden reference of Vee into new scenes and poses while preserving character identity. Uses FluxKontextImageScale + ReferenceLatent for proper Kontext conditioning.",
    "version": "2.0",
    "author": "vibecode-town pipeline"
  },
  "10": {
    "class_type": "UnetLoaderGGUF",
    "_meta": { "title": "Flux Kontext Dev GGUF" },
    "inputs": {
      "unet_name": "flux1-kontext-dev-Q5_K_S.gguf"
    }
  },
  "11": {
    "class_type": "DualCLIPLoaderGGUF",
    "_meta": { "title": "Dual CLIP (T5-XXL GGUF + CLIP-L)" },
    "inputs": {
      "clip_name1": "t5-v1_1-xxl-encoder-Q5_K_M.gguf",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    }
  },
  "12": {
    "class_type": "VAELoader",
    "_meta": { "title": "Flux VAE" },
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "50": {
    "class_type": "LoadImage",
    "_meta": { "title": "Golden Reference Input" },
    "inputs": {
      "image": "vee_2d_golden_front.png",
      "upload": "image"
    }
  },
  "51": {
    "class_type": "FluxKontextImageScale",
    "_meta": { "title": "Kontext Image Scale (auto resize)" },
    "inputs": {
      "image": ["50", 0]
    }
  },
  "52": {
    "class_type": "VAEEncode",
    "_meta": { "title": "VAE Encode (reference -> latent)" },
    "inputs": {
      "pixels": ["51", 0],
      "vae": ["12", 0]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Edit Instruction Prompt" },
    "inputs": {
      "text": "Change the character pose to sitting at a desk with a laptop, leaning forward with half-closed eyes in intense focus. Keep the same flat vector style, yellow hoodie, round black glasses, brown bob hair. 2D flat vector style, v3ct0r style, simple flat colors, thin outline, no gradients. Keep her exact face, hair, glasses, and yellow hoodie unchanged.",
      "clip": ["11", 0]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative Prompt" },
    "inputs": {
      "text": "3D, photorealistic, gradient, shading, texture, clay, claymation, fingerprint, detailed, complex, thin lines, realistic hands, fingers, text, watermark, speech bubble, multiple characters, anime, sketch, rough, different character, changed colors, changed outfit",
      "clip": ["11", 0]
    }
  },
  "55": {
    "class_type": "ReferenceLatent",
    "_meta": { "title": "ReferenceLatent (image+text fusion)" },
    "inputs": {
      "conditioning": ["6", 0],
      "latent": ["52", 0]
    }
  },
  "26": {
    "class_type": "FluxGuidance",
    "_meta": { "title": "Guidance (2.5)" },
    "inputs": {
      "guidance": 2.5,
      "conditioning": ["55", 0]
    }
  },
  "56": {
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "Empty Negative (Flux required)" },
    "inputs": {
      "conditioning": ["6", 0]
    }
  },
  "13": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler" },
    "inputs": {
      "seed": 0,
      "control_after_generate": "randomize",
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["10", 0],
      "positive": ["26", 0],
      "negative": ["56", 0],
      "latent_image": ["52", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": {
      "samples": ["13", 0],
      "vae": ["12", 0]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Output" },
    "inputs": {
      "filename_prefix": "vee_2d_edit",
      "images": ["8", 0]
    }
  }
}
