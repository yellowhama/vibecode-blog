{
  "_meta": {
    "title": "Flux.2 Klein 9B GGUF — T2I (No LoRA)",
    "description": "Klein 9B 기본 테스트용. LoRA 없이 순수 Klein 출력 확인.",
    "model": "flux-2-klein-9b-Q5_K_M.gguf + qwen_3_8b_fp8mixed.safetensors + flux2-vae.safetensors",
    "resolution": "832x1216",
    "vram": "~14GB",
    "notes": "LoRA 없는 버전. flux2_klein_9b_t2i.json에서 LoraLoader 제거."
  },
  "prompt": {
    "10": {
      "inputs": { "unet_name": "flux-2-klein-9b-Q5_K_M.gguf" },
      "class_type": "UnetLoaderGGUF",
      "_meta": { "title": "Klein 9B GGUF UNET" }
    },
    "11": {
      "inputs": {
        "clip_name": "qwen_3_8b_fp8mixed.safetensors",
        "type": "flux2",
        "weight_dtype": "default"
      },
      "class_type": "CLIPLoader",
      "_meta": { "title": "Qwen 3 8B FP8 (type=flux2)" }
    },
    "12": {
      "inputs": { "vae_name": "flux2-vae.safetensors" },
      "class_type": "VAELoader",
      "_meta": { "title": "Flux 2 VAE" }
    },
    "6": {
      "inputs": { "text": "POSITIVE_PROMPT_HERE", "clip": ["11", 0] },
      "class_type": "CLIPTextEncode",
      "_meta": { "title": "Positive Prompt" }
    },
    "7": {
      "inputs": { "text": "", "clip": ["11", 0] },
      "class_type": "CLIPTextEncode",
      "_meta": { "title": "Negative Prompt (empty)" }
    },
    "20": {
      "inputs": {
        "cfg": 5.0,
        "model": ["10", 0],
        "positive": ["6", 0],
        "negative": ["7", 0]
      },
      "class_type": "CFGGuider",
      "_meta": { "title": "CFG Guider" }
    },
    "21": {
      "inputs": { "sampler_name": "euler" },
      "class_type": "KSamplerSelect",
      "_meta": { "title": "Sampler Select" }
    },
    "22": {
      "inputs": {
        "steps": 20,
        "width": 832,
        "height": 1216
      },
      "class_type": "Flux2Scheduler",
      "_meta": { "title": "Flux2 Scheduler" }
    },
    "23": {
      "inputs": { "noise_seed": 42 },
      "class_type": "RandomNoise",
      "_meta": { "title": "Random Noise" }
    },
    "25": {
      "inputs": { "width": 832, "height": 1216, "batch_size": 1 },
      "class_type": "EmptyFlux2LatentImage",
      "_meta": { "title": "Empty Flux2 Latent" }
    },
    "24": {
      "inputs": {
        "noise": ["23", 0],
        "guider": ["20", 0],
        "sampler": ["21", 0],
        "sigmas": ["22", 0],
        "latent_image": ["25", 0]
      },
      "class_type": "SamplerCustomAdvanced",
      "_meta": { "title": "Advanced Sampler" }
    },
    "8": {
      "inputs": { "samples": ["24", 0], "vae": ["12", 0] },
      "class_type": "VAEDecode",
      "_meta": { "title": "VAE Decode" }
    },
    "9": {
      "inputs": { "filename_prefix": "Klein_T2I", "images": ["8", 0] },
      "class_type": "SaveImage",
      "_meta": { "title": "Save Output" }
    }
  }
}
