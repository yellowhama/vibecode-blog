{
  "_meta": {
    "title": "Flux.1-dev GGUF — T2I + LoRA",
    "description": "LoRA로 캐릭터 아이덴티티를 고정한 Flux T2I. vee_clay 트리거 워드로 일관된 Vee 생성.",
    "model": "flux1-dev-Q5_K_S.gguf + LoRA (Simple_Vector_Flux_v2_renderartist.safetensors)",
    "resolution": "1024x1024",
    "vram": "~9.2GB (Flux 9GB + LoRA overhead 0.2GB)",
    "notes": "lora_name에 safetensors 파일명 지정. 프롬프트에 'v3ct0r' 트리거 워드 포함 필수."
  },
  "prompt": {
    "10": {
      "inputs": { "unet_name": "flux1-dev-Q5_K_S.gguf" },
      "class_type": "UnetLoaderGGUF"
    },
    "11": {
      "inputs": {
        "clip_name1": "t5-v1_1-xxl-encoder-Q5_K_M.gguf",
        "clip_name2": "clip_l.safetensors",
        "type": "flux"
      },
      "class_type": "DualCLIPLoaderGGUF"
    },
    "12": {
      "inputs": { "vae_name": "ae.safetensors" },
      "class_type": "VAELoader"
    },
    "40": {
      "inputs": {
        "lora_name": "Simple_Vector_Flux_v2_renderartist.safetensors",
        "strength_model": 0.8,
        "strength_clip": 0.8,
        "model": ["10", 0],
        "clip": ["11", 0]
      },
      "class_type": "LoraLoader"
    },
    "6": {
      "inputs": { "text": "POSITIVE_PROMPT_HERE", "clip": ["40", 1] },
      "class_type": "CLIPTextEncode"
    },
    "26": {
      "inputs": { "guidance": 3.5, "conditioning": ["6", 0] },
      "class_type": "FluxGuidance"
    },
    "5": {
      "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
      "class_type": "EmptySD3LatentImage"
    },
    "13": {
      "inputs": {
        "seed": 42,
        "steps": 20,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0,
        "model": ["40", 0],
        "positive": ["26", 0],
        "negative": ["6", 0],
        "latent_image": ["5", 0]
      },
      "class_type": "KSampler"
    },
    "8": {
      "inputs": { "samples": ["13", 0], "vae": ["12", 0] },
      "class_type": "VAEDecode"
    },
    "9": {
      "inputs": { "filename_prefix": "Flux_LoRA_T2I", "images": ["8", 0] },
      "class_type": "SaveImage"
    }
  }
}
