    "20": {
      "inputs": {
        "add_noise": "enable",
        "noise_seed": 42,
        "steps": 4,
        "cfg": 1.0,
        "sampler_name": "sa_solver",
        "scheduler": "simple",
        "start_at_step": 0,
        "end_at_step": 2,
        "return_with_leftover_noise": "enable",
        "model": ["30", 0],
        "positive": ["50", 0],
        "negative": ["50", 1],
        "latent_image": ["50", 2]
      },
      "class_type": "KSamplerAdvanced",
      "_meta": { "title": "Stage 1 — HighNoise Lightning (steps 0→2, cfg 1.0)" }
    },
    "21": {
      "inputs": {
        "add_noise": "disable",
        "noise_seed": 42,
        "steps": 4,
        "cfg": 1.0,
        "sampler_name": "sa_solver",
        "scheduler": "simple",
        "start_at_step": 2,
        "end_at_step": 4,
        "return_with_leftover_noise": "disable",
        "model": ["31", 0],
        "positive": ["50", 0],
        "negative": ["50", 1],
        "latent_image": ["20", 0]
