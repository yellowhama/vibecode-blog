{
  "_meta": {
    "title": "Wan 2.2 GGUF MoE — Image to Video (Optimized, Lightning + FBCache + TeaCache + RIFE)",
    "description": "최적화 렌더링. Lightning LoRA(4 steps, shift 5) + FBCache(WaveSpeed) + TeaCache(0.3) + RIFE(16→32fps). 50분→7-12분/샷.",
    "model": "Wan2.2-I2V-A14B (HighNoise + LowNoise) Q3_K_M GGUF + Lightning LoRA",
    "resolution": "832x480",
    "frames": 81,
    "fps_render": 16,
    "fps_output": 32,
    "duration_sec": 5,
    "tested": "2026-03-19",
    "optimizations": ["Lightning LoRA (4 steps, shift 5)", "FBCache (threshold 0.12)", "TeaCache (threshold 0.3)", "RIFE x2 (16→32fps)"],
    "usage": "python animate_shots.py --workflow wan22_moe_i2v_optimized.json ..."
