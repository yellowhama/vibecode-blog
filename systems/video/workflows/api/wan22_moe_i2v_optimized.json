    "16": {
      "inputs": {
        "model": ["14", 0],
        "model_type": "wan2.1_i2v_480p_14B",
        "rel_l1_thresh": 0.3,
        "start_percent": 0.0,
        "end_percent": 1.0,
        "cache_device": "cuda"
      },
      "class_type": "TeaCache",
      "_meta": { "title": "TeaCache — HighNoise (threshold 0.3)" }
    },
    "17": {
      "inputs": {
        "model": ["15", 0],
        "model_type": "wan2.1_i2v_480p_14B",
        "rel_l1_thresh": 0.3,
        "start_percent": 0.0,
        "end_percent": 1.0,
        "cache_device": "cuda"
      },
      "class_type": "TeaCache",
      "_meta": { "title": "TeaCache — LowNoise (threshold 0.3)" }
