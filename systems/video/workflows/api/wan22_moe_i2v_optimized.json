    "99": {
      "inputs": {
        "frame_rate": 32,
        "loop_count": 0,
        "filename_prefix": "Wan22_I2V_Optimized",
        "format": "video/h264-mp4",
        "pingpong": false,
        "save_output": true,
        "pix_fmt": "yuv420p",
        "crf": 19,
        "save_metadata": true,
        "images": ["60", 0]
      },
      "class_type": "VHS_VideoCombine",
      "_meta": { "title": "Save Video (MP4 @ 32fps)" }
    }
  }
}
