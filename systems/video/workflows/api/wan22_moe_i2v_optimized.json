    "60": {
      "inputs": {
        "ckpt_name": "rife49.pth",
        "frames": ["8", 0],
        "clear_cache_after_n_frames": 10,
        "multiplier": 2,
        "fast_mode": true,
        "ensemble": true,
        "scale_factor": 1.0,
        "dtype": "float32",
        "torch_compile": false,
        "batch_size": 1
