      "class_type": "ApplyFBCacheOnModel",
      "_meta": { "title": "FBCache — HighNoise (threshold 0.12)" }
    },
    "15": {
      "inputs": {
        "model": ["13", 0],
        "object_to_patch": "diffusion_model",
