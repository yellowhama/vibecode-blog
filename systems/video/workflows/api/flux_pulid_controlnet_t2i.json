{
  "_meta": {
    "title": "Flux.1-dev GGUF — T2I + PuLID + ControlNet Pose",
    "description": "PuLID 얼굴 일관성 + ControlNet 포즈 제어 결합. 얼굴 고정 + 포즈 컨트롤 동시 사용.",
    "model": "flux1-dev-Q5_K_S.gguf + pulid_flux_v0.9.1 + flux-controlnet-union-pro",
    "resolution": "1024x1024",
    "vram": "~15.6GB ⚠️ (Flux 9GB + PuLID 1.1GB + EVA-CLIP 0.5GB + ControlNet 4GB + overhead 1GB)",
    "notes": "VRAM 빡빡함. OOM 시 --lowvram 또는 Flux Q4_K_M 다운그레이드. PuLID는 model 수정, ControlNet은 conditioning 수정 — 독립적으로 결합."
  },
  "prompt": {
    "10": {
      "inputs": { "unet_name": "flux1-dev-Q5_K_S.gguf" },
      "class_type": "UnetLoaderGGUF",
      "_meta": { "title": "Flux.1-dev GGUF" }
    },
    "11": {
      "inputs": {
        "clip_name1": "t5-v1_1-xxl-encoder-Q5_K_M.gguf",
        "clip_name2": "clip_l.safetensors",
        "type": "flux"
      },
      "class_type": "DualCLIPLoaderGGUF",
      "_meta": { "title": "Dual CLIP (T5-XXL GGUF + CLIP-L)" }
    },
    "12": {
      "inputs": { "vae_name": "ae.safetensors" },
      "class_type": "VAELoader",
      "_meta": { "title": "Flux VAE" }
    },
    "60": {
      "inputs": { "pulid_file": "pulid_flux_v0.9.1.safetensors" },
      "class_type": "PulidFluxModelLoader",
      "_meta": { "title": "PuLID Flux Model" }
    },
    "61": {
      "inputs": { "provider": "CPU" },
      "class_type": "PulidFluxInsightFaceLoader",
      "_meta": { "title": "InsightFace (CPU)" }
    },
    "62": {
      "inputs": { "image": "ivy_burr_golden_ref.png", "upload": "image" },
      "class_type": "LoadImage",
      "_meta": { "title": "Golden Reference Face Image" }
    },
    "64": {
      "inputs": {},
      "class_type": "PulidFluxEvaClipLoader",
      "_meta": { "title": "EVA-CLIP" }
    },
    "63": {
      "inputs": {
        "model": ["10", 0],
        "pulid_flux": ["60", 0],
        "eva_clip": ["64", 0],
        "face_analysis": ["61", 0],
        "image": ["62", 0],
        "weight": 1.0,
        "start_at": 0.0,
        "end_at": 1.0
      },
      "class_type": "ApplyPulidFlux",
      "_meta": { "title": "Apply PuLID Flux" }
    },
    "6": {
      "inputs": { "text": "POSITIVE_PROMPT_HERE", "clip": ["11", 0] },
      "class_type": "CLIPTextEncode",
      "_meta": { "title": "Prompt" }
    },
    "26": {
      "inputs": { "guidance": 3.5, "conditioning": ["6", 0] },
      "class_type": "FluxGuidance",
      "_meta": { "title": "Guidance" }
    },
    "5": {
      "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
      "class_type": "EmptySD3LatentImage",
      "_meta": { "title": "Empty Latent (1024x1024)" }
    },
    "30": {
      "inputs": { "image": "pose_reference.png", "upload": "image" },
      "class_type": "LoadImage",
      "_meta": { "title": "Pose Reference Image" }
    },
    "31": {
      "inputs": {
        "detect_hand": "enable",
        "detect_body": "enable",
        "detect_face": "enable",
        "resolution": 1024,
        "image": ["30", 0]
      },
      "class_type": "OpenposePreprocessor",
      "_meta": { "title": "OpenPose Preprocessor" }
    },
    "32": {
      "inputs": { "control_net_name": "flux-controlnet-union-pro.safetensors" },
      "class_type": "ControlNetLoader",
      "_meta": { "title": "Flux ControlNet Union Pro" }
    },
    "34": {
      "inputs": {
        "type": "openpose",
        "control_net": ["32", 0]
      },
      "class_type": "SetUnionControlNetType",
      "_meta": { "title": "Set ControlNet Type (OpenPose)" }
    },
    "33": {
      "inputs": {
        "strength": 0.7,
        "start_percent": 0.0,
        "end_percent": 0.9,
        "positive": ["26", 0],
        "negative": ["6", 0],
        "control_net": ["34", 0],
        "vae": ["12", 0],
        "image": ["31", 0]
      },
      "class_type": "ControlNetApplySD3",
      "_meta": { "title": "ControlNet Apply (strength 0.7)" }
    },
    "13": {
      "inputs": {
        "seed": 42,
        "steps": 20,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0,
        "model": ["63", 0],
        "positive": ["33", 0],
        "negative": ["33", 1],
        "latent_image": ["5", 0]
      },
      "class_type": "KSampler",
      "_meta": { "title": "KSampler (PuLID model + CN conditioning)" }
    },
    "8": {
      "inputs": { "samples": ["13", 0], "vae": ["12", 0] },
      "class_type": "VAEDecode",
      "_meta": { "title": "VAE Decode" }
    },
    "9": {
      "inputs": { "filename_prefix": "Flux_PuLID_CN_T2I", "images": ["8", 0] },
      "class_type": "SaveImage",
      "_meta": { "title": "Save Output" }
    }
  }
}
