{
  "_meta": {
    "title": "Wan 2.2 GGUF MoE — Text to Image",
    "description": "캐릭터 시트, 컨셉아트, 키프레임 생성용. EmptyLatent → 2-stage MoE denoise → SaveImage.",
    "model": "Wan2.2-I2V-A14B (HighNoise + LowNoise) Q3_K_M GGUF",
    "resolution": "1024x1024",
    "tested": "2026-03-10",
    "usage": "python comfy_batch_render.py --workflow api/wan22_moe_t2i.json --bindings api/wan22_moe_t2i_bindings.json"
  },
  "prompt": {
    "10": {
      "inputs": { "unet_name": "Wan2.2-I2V-A14B-HighNoise-Q3_K_M.gguf" },
      "class_type": "UnetLoaderGGUF",
      "_meta": { "title": "HighNoise UNET (Stage 1: Structure)" }
    },
    "11": {
      "inputs": { "unet_name": "Wan2.2-I2V-A14B-LowNoise-Q3_K_M.gguf" },
      "class_type": "UnetLoaderGGUF",
      "_meta": { "title": "LowNoise UNET (Stage 2: Refinement)" }
    },
    "30": {
      "inputs": { "shift": 8.0, "model": ["10", 0] },
      "class_type": "ModelSamplingSD3",
      "_meta": { "title": "HighNoise Shift (8.0)" }
    },
    "31": {
      "inputs": { "shift": 8.0, "model": ["11", 0] },
      "class_type": "ModelSamplingSD3",
      "_meta": { "title": "LowNoise Shift (8.0)" }
    },
    "2": {
      "inputs": { "vae_name": "wan_2.1_vae.safetensors" },
      "class_type": "VAELoader",
      "_meta": { "title": "Wan 2.1 VAE" }
    },
    "4": {
      "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan" },
      "class_type": "CLIPLoader",
      "_meta": { "title": "UMT5-XXL FP8 CLIP" }
    },
    "3": {
      "inputs": { "text": "POSITIVE_PROMPT_HERE", "clip": ["4", 0] },
      "class_type": "CLIPTextEncode",
      "_meta": { "title": "Positive Prompt" }
    },
    "7": {
      "inputs": { "text": "NEGATIVE_PROMPT_HERE", "clip": ["4", 0] },
      "class_type": "CLIPTextEncode",
      "_meta": { "title": "Negative Prompt" }
    },
    "5": {
      "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
      "class_type": "EmptyLatentImage",
      "_meta": { "title": "Empty Latent (1024x1024)" }
    },
    "20": {
      "inputs": {
        "add_noise": "enable",
        "noise_seed": 42,
        "steps": 35,
        "cfg": 2.5,
        "sampler_name": "uni_pc",
        "scheduler": "beta",
        "start_at_step": 0,
        "end_at_step": 8,
        "return_with_leftover_noise": "enable",
        "model": ["30", 0],
        "positive": ["3", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0]
      },
      "class_type": "KSamplerAdvanced",
      "_meta": { "title": "Stage 1 — HighNoise (steps 0→8, cfg 2.5)" }
    },
    "21": {
      "inputs": {
        "add_noise": "disable",
        "noise_seed": 42,
        "steps": 35,
        "cfg": 3.5,
        "sampler_name": "uni_pc",
        "scheduler": "beta",
        "start_at_step": 8,
        "end_at_step": 35,
        "return_with_leftover_noise": "disable",
        "model": ["31", 0],
        "positive": ["3", 0],
        "negative": ["7", 0],
        "latent_image": ["20", 0]
      },
      "class_type": "KSamplerAdvanced",
      "_meta": { "title": "Stage 2 — LowNoise (steps 8→35, cfg 3.5)" }
    },
    "8": {
      "inputs": { "samples": ["21", 0], "vae": ["2", 0] },
      "class_type": "VAEDecode",
      "_meta": { "title": "VAE Decode" }
    },
    "9": {
      "inputs": { "filename_prefix": "Wan22_T2I", "images": ["8", 0] },
      "class_type": "SaveImage",
      "_meta": { "title": "Save Output" }
    }
  }
}
