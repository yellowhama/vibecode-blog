{
  "version": "1.0",
  "workflow": "flux_controlnet_t2i.json",
  "description": "Flux T2I + ControlNet 포즈 바인딩 — 씬별 키프레임 생성용",
  "node_mappings": {
    "positive_prompt": { "node_id": "6", "field": "text" },
    "seed": { "node_id": "13", "field": "seed" },
    "guidance": { "node_id": "26", "field": "guidance" },
    "width": { "node_id": "5", "field": "width" },
    "height": { "node_id": "5", "field": "height" },
    "pose_image": { "node_id": "30", "field": "image" },
    "controlnet_strength": { "node_id": "33", "field": "strength" },
    "filename_prefix": { "node_id": "9", "field": "filename_prefix" }
  },
  "notes": {
    "pose_image": "ComfyUI input/ 폴더에 있는 포즈 레퍼런스 이미지 파일명",
    "controlnet_strength": "0.5=약하게, 0.7=기본, 0.9=강하게. 너무 높으면 포즈에 얼굴까지 끌려감.",
    "preprocessor": "OpenPose 자동 전처리. 스켈레톤 이미지를 직접 넣어도 됨."
  },
  "defaults": {
    "guidance": 3.5,
    "controlnet_strength": 0.7,
    "width": 1024,
    "height": 1024,
    "steps": 20,
    "cfg": 1.0,
    "sampler": "euler",
    "scheduler": "simple"
  }
}
